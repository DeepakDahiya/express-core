import("//build/config/android/rules.gni")
import("//brave/components/crash_reporting/buildflags.gni")
import("//testing/test.gni")

java_cpp_template("brave_minidump_uploader_config_java") {
  sources = [ "android/java/templates/BraveMinidumpUploaderConfig.template" ]
  defines = [
    "BROWSER_EXPRESS_CRASH_UPLOAD_URL=\"$browser_express_crash_upload_url\"",
    "BROWSER_EXPRESS_CRASH_PRODUCT=\"$browser_express_crash_product\"",
  ]
}

robolectric_library("junit") {
  deps = [
    "//base:base_java",
    "//base:base_java_test_support",
    "//base:base_junit_test_support",
    "//base/version_info/android:version_constants_java",
    "//components/minidump_uploader:minidump_uploader_java",
    "//third_party/androidx:androidx_test_runner_java",
    "//third_party/junit",
  ]
  sources = [
    "android/javatests/src/org/chromium/components/minidump_uploader/BraveHttpURLConnectionFactoryImplTest.java",
  ]
}
