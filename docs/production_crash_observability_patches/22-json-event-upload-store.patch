+    private static String normalizeToken(String token, String fallback) {
+        if (token.isEmpty() || token.length() > 32) {
+            return fallback;
+        }
+        for (int i = 0; i < token.length(); i++) {
+            char c = token.charAt(i);
+            boolean valid = (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_';
+            if (!valid) {
+                return fallback;
+            }
+        }
+        return token;
+    }
