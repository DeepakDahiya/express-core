+    private static String getAgeToken(long timestampMillis) {
+        if (timestampMillis <= 0) {
+            return "na";
+        }
+
+        long ageMillis = Math.max(0, System.currentTimeMillis() - timestampMillis);
+        if (ageMillis < 60_000) {
+            return "s";
+        }
+        if (ageMillis < 3_600_000) {
+            return "m";
+        }
+        if (ageMillis < 86_400_000) {
+            return "h";
+        }
+        return "d";
+    }
