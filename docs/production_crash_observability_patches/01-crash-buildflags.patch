diff --git a/components/crash_reporting/buildflags.gni b/components/crash_reporting/buildflags.gni
new file mode 100644
index 0000000000..f98a8d01ba
--- /dev/null
+++ b/components/crash_reporting/buildflags.gni
@@ -0,0 +1,23 @@
+# Copyright (c) 2026 The Browser Express Authors. All rights reserved.
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this file,
+# You can obtain one at https://mozilla.org/MPL/2.0/.
+
+declare_args() {
+  # Owned Crashpad/minidump upload endpoint. This must be set for official
+  # production builds so inherited Brave/Google crash endpoints are not used.
+  browser_express_crash_upload_url = ""
+
+  # Product value attached by the Android Java minidump uploader.
+  browser_express_crash_product = "BrowserExpress_Android"
+}
+
+if (is_official_build) {
+  assert(browser_express_crash_upload_url != "",
+         "Set browser_express_crash_upload_url for official builds.")
+}
+
+assert(browser_express_crash_upload_url != "https://cr.brave.com",
+       "Do not use Brave's crash endpoint for this fork.")
+assert(browser_express_crash_upload_url != "https://clients2.google.com/cr/report",
+       "Do not use Google's crash endpoint for this fork.")
