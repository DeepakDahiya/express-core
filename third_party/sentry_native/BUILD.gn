import("//build/config/c++/c++.gni")

config("sentry_config") {
  include_dirs = [ "include" ]
  defines = [
    "SENTRY_BUILD_STATIC",
    "SENTRY_WITH_CRASHPAD=OFF",  # Disable Sentry's crashpad, use Chromium's
  ]
}

static_library("sentry_native") {
  sources = [
    "src/sentry.c",
    "src/sentry_backend.c",
    "src/sentry_envelope.c",
    "src/sentry_event.c",
    "src/sentry_path.c",
    "src/sentry_scope.c",
    "src/sentry_session.c",
    "src/sentry_string.c",
    "src/sentry_sync.c",
    "src/sentry_transport.c",
    "src/sentry_utils.c",
    "src/sentry_value.c",
    "src/sentry_alloc.c",
    "src/sentry_core.c",
    "src/sentry_database.c",
    "src/sentry_json.c",
    "src/sentry_logger.c",
    "src/sentry_modulefinder.c",
    "src/sentry_os.c",
    "src/sentry_random.c",
    "src/sentry_slice.c",
    "src/sentry_symbolizer.c",
    "src/sentry_unwinder.c",
    "src/sentry_uuid.c",
  ]

  public_configs = [ ":sentry_config" ]
}