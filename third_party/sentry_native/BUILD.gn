import("//build/config/c++/c++.gni")

config("sentry_native_config") {
  include_dirs = [
    "include",
    "src",
  ]
  defines = [
    "SENTRY_BUILD_STATIC",
    "SENTRY_WITH_CRASHPAD=OFF",  # Disable Sentry's crashpad, use Chromium's
  ]
  cflags = [
    "-Wno-shadow",
  ]
}

static_library("sentry_native") {
  sources = [
    # Backends
    "src/backends/sentry_backend_inproc.c",
    "src/backends/sentry_backend_none.c",

    # Linux/Android module finder
    "src/modulefinder/sentry_modulefinder_linux.c",

    # Path handling for Unix/Android
    "src/path/sentry_path_unix.c",
    "src/path/sentry_path.c",

    # Core Sentry sources
    "src/sentry_alloc.c",
    "src/sentry_backend.c",
    "src/sentry_core.c",
    "src/sentry_database.c",
    "src/sentry_envelope.c",
    "src/sentry_info.c",
    "src/sentry_json.c",
    "src/sentry_logger.c",
    "src/sentry_options.c",
    "src/sentry_os.c",
    "src/sentry_random.c",
    "src/sentry_ratelimiter.c",
    "src/sentry_scope.c",
    "src/sentry_session.c",
    "src/sentry_slice.c",
    "src/sentry_string.c",
    "src/sentry_sync.c",
    "src/sentry_tracing.c",
    "src/sentry_transport.c",
    "src/sentry_unix_pageallocator.c",
    "src/sentry_utils.c",
    "src/sentry_uuid.c",
    "src/sentry_value.c",

    # Symbolizer for Unix/Android
    "src/symbolizer/sentry_symbolizer_unix.c",

    # Transports (disk + function)
    "src/transports/sentry_disk_transport.c",
    "src/transports/sentry_function_transport.c",
    "src/transports/sentry_transport_none.c",

    # Unwinder for Unix/Android
    "src/unwinder/sentry_unwinder_libbacktrace.c",
    "src/unwinder/sentry_unwinder.c",
  ]

  public_configs = [ ":sentry_native_config" ]

  deps = [
    "//third_party/crashpad/crashpad/client:common",
    "//third_party/crashpad/crashpad/client:client",
    "//third_party/crashpad/crashpad/util:util",
  ]
}