import("//build/config/android/rules.gni")

android_aar_prebuilt("sentry_android_sdk_prebuilt") {
  aar_path = "sentry-android-7.9.0.aar"
}

android_aar_prebuilt("sentry_android_okhttp_prebuilt") {
  aar_path = "sentry-android-okhttp-7.9.0.aar"
}

android_library("sentry_android_sdk") {
  deps = [
    ":sentry_android_sdk_prebuilt",
  ]
}

android_library("sentry_android_okhttp") {
  deps = [
    ":sentry_android_okhttp_prebuilt",
    ":sentry_android_sdk", # This creates the correct dependency chain
  ]
}