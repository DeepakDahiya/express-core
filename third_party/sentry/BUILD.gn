import("//build/config/android/rules.gni")

android_aar_prebuilt("sentry_android_sdk") {
  aar_path = "sentry-android-7.9.0.aar"
}

android_aar_prebuilt("sentry_android_okhttp") {
  aar_path = "sentry-android-okhttp-7.9.0.aar"

  deps = [
    ":sentry_android_sdk",
  ]
}

group("sentry_java") {
  deps = [
    ":sentry_android_sdk",
    ":sentry_android_okhttp",
  ]
}