import("//build/config/android/rules.gni")

java_prebuilt("sentry_java") {
  jar_path = "sentry-7.9.0.jar"
  supports_android = true
}

java_prebuilt("sentry_android_core_java") {
  jar_path = "sentry-android-core-7.9.0.jar"
  supports_android = true
  deps = [
    ":sentry_java",
  ]
}

java_prebuilt("sentry_android_fragment_java") {
  jar_path = "sentry-android-fragment-7.9.0.jar"
  supports_android = true
  deps = [
    ":sentry_android_core_java",
    ":sentry_java",
  ]
}

java_prebuilt("sentry_android_timber_java") {
  jar_path = "sentry-android-timber-7.9.0.jar"
  supports_android = true
  deps = [
    ":sentry_android_core_java",
    ":sentry_java",
  ]
}

java_prebuilt("sentry_okhttp_java") {
  jar_path = "sentry-okhttp-7.9.0.jar"
  supports_android = true
  deps = [
    ":sentry_java",
  ]
}

java_prebuilt("sentry_android_okhttp_java") {
  jar_path = "sentry-android-okhttp-7.9.0.jar"
  supports_android = true
  deps = [
    ":sentry_okhttp_java",
    ":sentry_android_core_java",
    ":sentry_java",
  ]
}

# Group target for all Sentry dependencies
group("sentry_all") {
  deps = [
    ":sentry_java",
    ":sentry_android_core_java",
    ":sentry_android_fragment_java",
    ":sentry_android_timber_java", 
    ":sentry_okhttp_java",
    ":sentry_android_okhttp_java",
  ]
}