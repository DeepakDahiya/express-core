module brave.mojom;

import "ui/gfx/geometry/mojom/geometry.mojom";
import "gpu/ipc/common/surface_handle.mojom";

// Interface for streaming video frames to a surface
interface VideoSurfaceStreamer {
  // Start streaming video to the given surface token
  StartStreaming(gpu.mojom.SurfaceHandle surface_handle) => (bool success);
  
  // Stop streaming video
  StopStreaming();
  
  // Control playback
  TogglePlayback();
  
  // Update streaming parameters
  UpdateStreamingParams(gfx.mojom.Size video_size, float frame_rate);
};