import("//build/config/android/rules.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//third_party/jni_zero/jni_zero.gni")

# Mojo interface definition
mojom("mojom") {
  sources = [ "mojom/video_surface_streamer.mojom" ]
  
  public_deps = [
    "//mojo/public/mojom/base",
    "//ui/gfx/geometry/mojom",
  ]
}

# Main source set for browser-side code
source_set("youtube_script_injector") {
  sources = [
    "brave_youtube_script_injector_native_helper.cc",
    "brave_youtube_script_injector_native_helper.h",
    "youtube_script_injector_tab_helper.cc",
    "youtube_script_injector_tab_helper.h",
    "//chrome/android:chrome_java",
    "//chrome/browser/tab:java",
  ]
  
  public_deps = [ 
    "//content/public/browser",
    ":mojom",
  ]
  
  deps = [
    ":features",
    "//base",
    "//brave/browser/android/youtube_script_injector:jni_headers",
    "//brave/components/brave_shields/content/browser",
    "//brave/components/constants",
    "//brave/components/script_injector/common/mojom",
    "//chrome/browser/profiles:profile",
    "//chrome/common",
    "//components/prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//net",
    "//ui/android",
    "//ui/gl",
    "//url",
  ]
}

# Java library for Android
android_library("java") {
  srcjar_deps = [ ":jni_headers" ]
  sources = [ 
    "java/org/chromium/chrome/browser/BraveYouTubeScriptInjectorNativeHelper.java",
    "../../../android/java/org/chromium/chrome/browser/media/BraveMiniPlayerManager.java",
  ]
  deps = [
    "//base:base_java",
    "//content/public/android:content_full_java",
    "//third_party/jni_zero:jni_zero_java",
    "//ui/android:ui_no_recycler_view_java",
  ]
  resources_package = "org.chromium.chrome.browser"
}

# Features configuration
source_set("features") {
  sources = [
    "features.cc",
    "features.h",
  ]
  public_deps = [ "//base" ]
}

# JNI header generation
generate_jni("jni_headers") {
  sources = [ 
    "java/org/chromium/chrome/browser/BraveYouTubeScriptInjectorNativeHelper.java",
  ]
}

# Browser tests
source_set("browser_tests") {
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  testonly = true
  sources = [
    "youtube_script_injector_browsertest.cc",
    "youtube_script_injector_tab_helper_browsertest.cc",
  ]
  deps = [
    ":features",
    ":youtube_script_injector",
    "//base",
    "//brave/components/constants",
    "//chrome/test:test_support",
    "//net:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}

# Unit tests
source_set("unit_tests") {
  testonly = true
  sources = [ "youtube_script_injector_tab_helper_unittest.cc" ]
  deps = [
    ":youtube_script_injector",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//testing/gtest",
  ]
}