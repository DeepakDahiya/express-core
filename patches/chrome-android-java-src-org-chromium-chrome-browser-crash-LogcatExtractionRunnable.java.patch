+    private static void uploadMinidumpToSentry(File minidumpFile) {
+        // Always use a background thread for crash uploads to avoid ANRs and crash loops.
+        new Thread(() -> {
+            // Temporarily permit all thread policies for crash reporting
+            StrictMode.ThreadPolicy originalPolicy = StrictMode.getThreadPolicy();
+            StrictMode.setThreadPolicy(new StrictMode.ThreadPolicy.Builder()
+                    .permitAll()
+                    .build());
+            try {
+                boolean success = performCrashSafeUpload(minidumpFile);
+                if (success) {
+                    Log.i(TAG, "Sentry upload successful for " + minidumpFile.getName());
+                } else {
+                    Log.e(TAG, "Sentry upload failed for " + minidumpFile.getName());
+                }
+            } finally {
+                // Restore original policy
+                StrictMode.setThreadPolicy(originalPolicy);
+            }
+        }, "SentryUploadThread").start();
+    }
