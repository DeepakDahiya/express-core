+    /**
+     * Performs the network request to upload the minidump.
+     * This method contains detailed logging for easier debugging.
+     */
+    private static boolean performCrashSafeUpload(File minidumpFile) {
+        Log.i(TAG, "=== Starting Sentry Upload ===");
+        long dumpSize = minidumpFile.length();
+        Log.e(TAG, "Minidump size: " + dumpSize + " bytes (" + (dumpSize / 1024 / 1024) + " MB)");
+        
+        if (!isNetworkAvailable()) {
+            Log.e(TAG, "No network available.");
+            return false;
+        }
+        
+        if (minidumpFile == null || !minidumpFile.exists() || minidumpFile.length() == 0) {
+            Log.e(TAG, "Invalid minidump file.");
+            return false;
+        }
+        
+        HttpURLConnection conn = null;
+        try {
+            String boundary = "----SentryBoundary" + System.currentTimeMillis();
+            URL url = new URL(SENTRY_MINIDUMP_URL);
+            
+            ByteArrayOutputStream baos = new ByteArrayOutputStream();
+            DataOutputStream out = new DataOutputStream(baos);
+            
+            // 1️⃣ Minidump part
+            out.writeBytes("--" + boundary + "\r\n");
+            out.writeBytes("Content-Disposition: form-data; name=\"upload_file_minidump\"; filename=\"" 
+                + minidumpFile.getName() + "\"\r\n");
+            out.writeBytes("Content-Type: application/octet-stream\r\n");
+            out.writeBytes("\r\n"); // empty line required
+            
+            try (FileInputStream fis = new FileInputStream(minidumpFile)) {
+                byte[] buffer = new byte[4096];
+                int bytesRead;
+                while ((bytesRead = fis.read(buffer)) != -1) {
+                    out.write(buffer, 0, bytesRead);
+                }
+            }
+            out.writeBytes("\r\n"); // end of file part
+            
+            // 2️⃣ Sentry metadata part - REMOVED Content-Type header
+            // String sentryJson = "{\"release\":\"chromium@0.0.217\"}";
+            // out.writeBytes("--" + boundary + "\r\n");
+            // out.writeBytes("Content-Disposition: form-data; name=\"sentry\"\r\n");
+            // // REMOVED: out.writeBytes("Content-Type: application/json\r\n");
+            // out.writeBytes("\r\n"); // empty line before content
+            // out.write(sentryJson.getBytes("UTF-8"));
+            // out.writeBytes("\r\n");
+            
+            // 3️⃣ Closing boundary
+            out.writeBytes("--" + boundary + "--\r\n");
+            out.flush();
+            
+            byte[] body = baos.toByteArray();
+            Log.d(TAG, "Multipart body size: " + body.length + " bytes");
+            
+            conn = (HttpURLConnection) url.openConnection();
+            conn.setConnectTimeout(15000);
+            conn.setReadTimeout(30000);
+            conn.setDoOutput(true);
+            conn.setRequestMethod("POST");
+            conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
+            conn.setRequestProperty("User-Agent", "Android-Crash-Reporter/1.0");
+            conn.setFixedLengthStreamingMode(body.length);
+            
+            try (OutputStream os = conn.getOutputStream()) {
+                os.write(body);
+                os.flush();
+            }
+            
+            int code = conn.getResponseCode();
+            Log.i(TAG, "Sentry response: " + code + " " + conn.getResponseMessage());
+            
+            if (code >= 400) {
+                try (InputStream err = conn.getErrorStream()) {
+                    if (err != null) {
+                        BufferedReader r = new BufferedReader(new InputStreamReader(err));
+                        String line;
+                        StringBuilder sb = new StringBuilder();
+                        while ((line = r.readLine()) != null) {
+                            sb.append(line);
+                        }
+                        Log.e(TAG, "Sentry error response body: " + sb.toString());
+                    }
+                }
+            }
+            
+            return (code >= 200 && code < 300);
+            
+        } catch (Exception e) {
+            Log.e(TAG, "Error uploading to Sentry", e);
+            return false;
+        } finally {
+            if (conn != null) conn.disconnect();
+            Log.i(TAG, "=== Sentry Upload Finished ===");
+        }
+    }
