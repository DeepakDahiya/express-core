+    private static void logMinidumpInfo(File minidumpFile) {
+        if (!minidumpFile.exists()) {
+            Log.e("BraveSentry", "Minidump file does not exist: " + minidumpFile.getAbsolutePath());
+            return;
+        }
+
+        long size = minidumpFile.length();
+        Log.e("BraveSentry", "Minidump path: " + minidumpFile.getAbsolutePath());
+        Log.e("BraveSentry", "Minidump size: " + size + " bytes");
+
+        try (FileInputStream fis = new FileInputStream(minidumpFile)) {
+            byte[] header = new byte[16];
+            int read = fis.read(header);
+            if (read > 0) {
+                StringBuilder hex = new StringBuilder();
+                for (int i = 0; i < read; i++) {
+                    hex.append(String.format("%02X ", header[i]));
+                }
+                Log.e("BraveSentry", "First " + read + " bytes (hex): " + hex.toString());
+            }
+        } catch (Exception e) {
+            Log.e("BraveSentry", "Error reading minidump file", e);
+        }
+    }
