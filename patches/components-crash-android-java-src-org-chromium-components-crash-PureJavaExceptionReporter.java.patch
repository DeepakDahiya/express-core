+    private static void uploadMinidumpToSentry(File minidumpFile) {
+        Log.e("BraveSentry", "Inside uploadMinidumpToSentry");
+        new Thread(() -> {
+            try {
+                Log.e("BraveSentry", "Thread started");
+
+                String boundary = "----SentryBoundary" + System.currentTimeMillis();
+                Log.e("BraveSentry", "Boundary: " + boundary);
+
+                HttpURLConnection conn = (HttpURLConnection) new URL(SENTRY_MINIDUMP_URL).openConnection();
+                Log.e("BraveSentry", "Connection opened");
+
+                conn.setDoOutput(true);
+                conn.setRequestMethod("POST");
+                conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary);
+
+                Log.e("BraveSentry", "Before getOutputStream()");
+                try (DataOutputStream out = new DataOutputStream(conn.getOutputStream())) {
+                    Log.e("BraveSentry", "OutputStream opened");
+
+                    // Minidump file
+                    out.writeBytes("--" + boundary + "\r\n");
+                    out.writeBytes("Content-Disposition: form-data; name=\"upload_file_minidump\"; filename=\"" + minidumpFile.getName() + "\"\r\n");
+                    out.writeBytes("Content-Type: application/octet-stream\r\n\r\n");
+
+                    Log.e("BraveSentry", "Before file copy, size=" + minidumpFile.length());
+                    try (FileInputStream fis = new FileInputStream(minidumpFile)) {
+                        byte[] buffer = new byte[8192];
+                        int bytesRead;
+                        while ((bytesRead = fis.read(buffer)) != -1) {
+                            out.write(buffer, 0, bytesRead);
+                        }
+                    }
+                    Log.e("BraveSentry", "File copy done");
+
+                    out.writeBytes("\r\n");
+
+                    // Optional: release info
+                    out.writeBytes("--" + boundary + "\r\n");
+                    out.writeBytes("Content-Disposition: form-data; name=\"sentry[release]\"\r\n\r\n");
+                    out.writeBytes("chromium@" + "0.0.217" + "\r\n");
+
+                    out.writeBytes("--" + boundary + "--\r\n");
+                }
+                Log.e("BraveSentry", "OutputStream closed");
+
+                Log.e("BraveSentry", "Before getResponseCode()");
+                int responseCode = conn.getResponseCode();
+                Log.e("BraveSentry", "Response code: " + responseCode);
+            } catch (Exception e) {
+                Log.e("BraveSentry", "Upload failed", e);
+            }
+        }).start();
+    }
+
