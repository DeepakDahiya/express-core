<!-- A comment card (Figma "Express/Comment Card", light 1:142 / dark 3:597): author and time,
     the text, then a voice note, a photo/video or a document, and the actions row — replies on
     the left; add-reaction, the top reactions and the overflow menu on the right. Cards sit 16dp
     in from the screen edges and 4dp apart; CommentRowMeasurer.applyPagerRowSpacing keeps the
     reel pager's rows to exactly this spacing. CommentListAdapter.CommentHolder binds it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/comment_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/browser_express_post_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Author, then NEW on a take the reader hasn't seen, right after the name; the time stays
         at the end. A packed chain keeps NEW beside the name while a long name ellipsizes. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="16dp">

        <ImageView
            android:id="@+id/avatar_image"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/browser_express_post_avatar_placeholder"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/browser_express_post_author"
            android:textSize="12sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/comment_new_tag"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@id/avatar_image"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/comment_new_tag"
            style="@style/BrowserExpressCommentNewTag"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/browser_express_comment_new_tag_bg"
            android:paddingHorizontal="6dp"
            android:textSize="9.5sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/comment_time"
            app:layout_constraintStart_toEndOf="@id/username"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp" />

        <TextView
            android:id="@+id/comment_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="@color/browser_express_post_time"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="3h ago"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/comment_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif"
        android:lineHeight="20sp"
        android:textColor="@color/browser_express_post_caption"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_read_more_comment"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fontFamily="sans-serif-medium"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingHorizontal="0dp"
        android:paddingVertical="2dp"
        android:text="@string/browser_express_post_more"
        android:textAllCaps="false"
        android:textColor="@color/browser_express_post_more"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/posting_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/failed_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/post_failed"
        android:textColor="@color/browser_express_error_color"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Voice note (Figma "Express/Audio player"), the same player a voice post uses. It is a
         fixed-height row, so CommentSlidePacker packs it onto a shared page. -->
    <LinearLayout
        android:id="@+id/comment_audio_row"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/browser_express_post_audio_bg"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageButton
            android:id="@+id/audio_play_pause"
            android:layout_width="43dp"
            android:layout_height="43dp"
            android:background="@null"
            android:contentDescription="@string/be_audio_play"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_browser_express_post_audio_play" />

        <SeekBar
            android:id="@+id/audio_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:progressDrawable="@drawable/browser_express_post_audio_progress"
            android:splitTrack="false"
            android:thumb="@drawable/browser_express_post_audio_thumb" />

        <TextView
            android:id="@+id/audio_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineHeight="16sp"
            android:textColor="@color/browser_express_post_audio_time"
            android:textFontWeight="600"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/comment_media_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/browser_express_media_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Space
                android:id="@+id/media_aspect_ratio_spacer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/comment_video"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintEnd_toEndOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintStart_toStartOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintTop_toTopOf="@id/media_aspect_ratio_spacer"
                app:resize_mode="fit"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <ImageView
                android:id="@+id/comment_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:scaleType="fitCenter"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintEnd_toEndOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintStart_toStartOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintTop_toTopOf="@id/media_aspect_ratio_spacer" />

            <!-- Figma "Express/Media" Type=Video: shown until the video starts. -->
            <ImageView
                android:id="@+id/play_pause_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/browser_express_video_viewer_play"
                android:src="@drawable/ic_browser_express_comment_video_play"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintEnd_toEndOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintStart_toStartOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintTop_toTopOf="@id/media_aspect_ratio_spacer" />

            <ProgressBar
                android:id="@+id/video_progress"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintEnd_toEndOf="@id/media_aspect_ratio_spacer"
                app:layout_constraintStart_toStartOf="@id/media_aspect_ratio_spacer" />

            <ImageButton
                android:id="@+id/video_mute_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="8dp"
                android:background="@drawable/circular_button_background"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:padding="4dp"
                android:src="@drawable/volume_off"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:tint="@android:color/white"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- A document attachment: its icon, name and size. Tapping opens it. -->
    <LinearLayout
        android:id="@+id/comment_document_row"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/browser_express_post_audio_bg"
        android:baselineAligned="false"
        android:contentDescription="@string/browser_express_comment_open_document"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_browser_express_attach_document" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/comment_document_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/browser_express_post_caption"
                android:textSize="13sp"
                tools:text="Quarterly report.pdf" />

            <TextView
                android:id="@+id/comment_document_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/browser_express_post_time"
                android:textSize="11sp"
                tools:text="PDF · 1.2 MB" />
        </LinearLayout>
    </LinearLayout>

    <!-- Several files (Figma "Outgoing comment morph", 498:2056): a row of 88dp x 56dp tiles,
         photos and video stills with a document's type and size between them. CommentListAdapter
         fills it. -->
    <HorizontalScrollView
        android:id="@+id/comment_attachment_tiles_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/comment_attachment_tiles"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- A video this reader is sending: its still, length, file name and size, and Retry or
         Cancel while that applies. -->
    <LinearLayout
        android:id="@+id/comment_outgoing_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/comment_outgoing_video_frame"
            android:layout_width="150dp"
            android:layout_height="130dp"
            android:background="@drawable/browser_express_comment_outgoing_video_bg">

            <ImageView
                android:id="@+id/comment_outgoing_video_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_browser_express_comment_tile_play_36" />

            <TextView
                android:id="@+id/comment_outgoing_video_duration"
                android:layout_width="40dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:background="@drawable/browser_express_comment_duration_badge_bg"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/browser_express_comment_duration_badge_text"
                android:textSize="9sp"
                tools:ignore="SmallSp"
                tools:text="00:24" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/comment_outgoing_video_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/browser_express_comment_outgoing_meta"
                android:textSize="11sp"
                tools:text="city-walk.mp4" />

            <TextView
                android:id="@+id/comment_outgoing_video_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/browser_express_comment_outgoing_meta"
                android:textSize="11sp"
                tools:text="18.6 MB · Reel" />
        </LinearLayout>

        <TextView
            android:id="@+id/comment_outgoing_video_action"
            style="@style/BrowserExpressCommentUploadAction"
            android:layout_marginTop="6dp"
            tools:text="Retry" />
    </LinearLayout>

    <!-- Upload progress of a comment being sent (Figma "Upload progress"). -->
    <ProgressBar
        android:id="@+id/comment_upload_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:max="1000"
        android:progressDrawable="@drawable/browser_express_comment_upload_progress"
        android:visibility="gone"
        tools:progress="380"
        tools:visibility="visible" />

    <!-- Retry or Cancel for a sending comment that has no video row to hold it. -->
    <TextView
        android:id="@+id/comment_upload_action"
        style="@style/BrowserExpressCommentUploadAction"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        tools:text="Retry" />

    <LinearLayout
        android:id="@+id/action_items"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_reply"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:text="@string/browser_express_comment_reply"
            android:textColor="@color/browser_express_comment_replies"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_add_reaction"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_express_comment_add_reaction"
            android:padding="4dp"
            android:src="@drawable/ic_browser_express_comment_smiley" />

        <LinearLayout
            android:id="@+id/reaction_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reaction_chip_1"
                style="@style/BrowserExpressCommentReactionChip"
                tools:text="👍 58" />

            <TextView
                android:id="@+id/reaction_chip_2"
                style="@style/BrowserExpressCommentReactionChip"
                android:layout_marginStart="4dp"
                tools:text="❤️ 9" />

            <TextView
                android:id="@+id/reaction_chip_3"
                style="@style/BrowserExpressCommentReactionChip"
                android:layout_marginStart="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/reaction_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/browser_express_comment_reaction_count"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="+7"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btn_comment_more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_express_comment_more"
            android:padding="4dp"
            android:src="@drawable/ic_browser_express_comment_more" />
    </LinearLayout>
</LinearLayout>
