<LinearLayout
    android:id="@+id/comment_bottomsheet_layout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:orientation="vertical"
    app:behavior_fitToContents="false"
    android:background="@color/be_background_black"
    tools:context=".BrowserExpressCommentsBottomSheetFragment">

    <View
        android:id="@+id/sheet_title"
        android:layout_width="30dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:background="@color/content_color"/>

    <FrameLayout
        android:id="@+id/bottom_sheet_container"
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="0dp" />

    <LinearLayout
        android:id="@+id/sheet_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5sp"
        android:orientation="vertical"
        android:background="@drawable/sheet_button_top_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5sp"
            android:weightSum="6">

            <Button
                android:id="@+id/lol_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/lol"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/heart_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/heart"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/cry_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cry"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/fire_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/fire"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/love_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/love"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/clap_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/clap"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/attachment_preview_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="start"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:padding="2dp">

            <ImageView
                android:id="@+id/attachment_preview_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="300dp"
                android:maxHeight="200dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                tools:src="@tools:sample/backgrounds/scenic"
                android:background="@drawable/comment_attachment_preview_border"
                android:padding="1dp"
                android:layout_gravity="start"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>

            <ImageButton
                android:id="@+id/button_remove_attachment"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_gravity="top|end"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/input_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="5sp"
            android:paddingBottom="5sp"
            android:paddingStart="0sp"
            android:paddingEnd="0sp">

            <ImageView
                android:id="@+id/avatar_image"
                android:src="@drawable/btn_toolbar_profile"
                android:layout_width="24sp"
                android:layout_height="24sp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>

            <EditText
                android:id="@+id/comment_content_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:inputType="textImeMultiLine|textMultiLine"
                android:paddingEnd="18dp"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:maxLines="6"
                android:textSize="14sp"
                android:textColor="@color/wallet_text_color"
                android:textColorHint="@color/brave_theme_hint_text"
                android:hint="@string/type_your_comment"
                android:background="@drawable/rounded_edittext"
                android:layout_marginEnd="8dp"
                tools:ignore="Autofill" />

            <ImageButton
                android:id="@+id/button_attach"
                style="@style/ToolbarButton"
                android:src="@drawable/attach"
                android:layout_width="28sp"
                android:layout_height="28sp"
                android:padding="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>

            <ImageButton android:id="@+id/button_send"
                style="@style/ToolbarButton"
                android:background="@drawable/send"
                android:layout_width="28sp"
                android:layout_height="28sp"
                android:visibility="visible"
                android:contentDescription="@string/send_comment" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>