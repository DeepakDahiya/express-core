<!-- Edit profile's photo options (design handoff "Edit profile" §3): an action sheet over a
     scrim, 8dp in from the sides and 30dp up from the bottom, with a separate Cancel card. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/edit_profile_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/browser_express_edit_profile_scrim" />

    <!-- Padded clear of the system bars; the padding is see-through and taps there reach the
         scrim. -->
    <LinearLayout
        android:id="@+id/edit_profile_overlay_insets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="30dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/edit_profile_sheet_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/browser_express_edit_profile_sheet_bg"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/browser_express_edit_profile_photo"
                android:textColor="@color/browser_express_profile_text_meta"
                android:textFontWeight="500"
                android:textSize="13sp" />

            <!-- Shown once the camera permission was refused; opens the app's settings. -->
            <TextView
                android:id="@+id/edit_profile_sheet_camera_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineHeight="18sp"
                android:paddingHorizontal="18dp"
                android:paddingBottom="12dp"
                android:text="@string/browser_express_edit_profile_camera_settings"
                android:textColor="@color/browser_express_edit_profile_link"
                android:textFontWeight="500"
                android:textSize="13sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/browser_express_profile_divider" />

            <TextView
                android:id="@+id/edit_profile_sheet_take_photo"
                style="@style/BrowserExpressEditProfileSheetRow"
                android:text="@string/browser_express_edit_profile_take_photo"
                android:textColor="@color/browser_express_profile_text_primary"
                app:drawableStartCompat="@drawable/ic_browser_express_edit_profile_take_photo"
                app:drawableTint="@color/browser_express_profile_text_primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/browser_express_profile_divider" />

            <TextView
                android:id="@+id/edit_profile_sheet_library"
                style="@style/BrowserExpressEditProfileSheetRow"
                android:text="@string/browser_express_edit_profile_choose_photo"
                android:textColor="@color/browser_express_profile_text_primary"
                app:drawableStartCompat="@drawable/ic_browser_express_edit_profile_library"
                app:drawableTint="@color/browser_express_profile_text_primary" />

            <!-- Only while there is a photo of their own to remove. -->
            <LinearLayout
                android:id="@+id/edit_profile_sheet_remove_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/browser_express_profile_divider" />

                <TextView
                    android:id="@+id/edit_profile_sheet_remove"
                    style="@style/BrowserExpressEditProfileSheetRow"
                    android:text="@string/browser_express_edit_profile_remove_photo"
                    android:textColor="@color/browser_express_profile_danger"
                    app:drawableStartCompat="@drawable/ic_browser_express_edit_profile_remove"
                    app:drawableTint="@color/browser_express_profile_danger" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/edit_profile_sheet_cancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/browser_express_edit_profile_sheet_bg"
            android:fontFamily="sans-serif"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/browser_express_edit_profile_cancel"
            android:textColor="@color/browser_express_profile_text_primary"
            android:textFontWeight="600"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
