<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/fullscreen_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/fullscreen_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:use_controller="true"
        app:controller_layout_id="@layout/exo_player_control_view"
        android:visibility="gone" />

    <!-- "2×" while the reader holds the right half of the video. -->
    <include
        layout="@layout/browser_express_fast_forward_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp" />

    <!-- Shown instead of the close button when the viewer is opened as a page of its own — from
         a post's video, where back belongs to the comments underneath rather than to a dismiss. -->
    <include
        android:id="@+id/media_viewer_header"
        layout="@layout/browser_express_comment_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/close_button_fullscreen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        app:tint="@android:color/white"
        android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

</FrameLayout>