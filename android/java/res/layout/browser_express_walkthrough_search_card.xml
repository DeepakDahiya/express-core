<!-- Walkthrough step 1, "The Internet, Upgraded" (design_handoff_walkthrough README §3): the card
     under the search bar, its caret pointing up at it. WalkthroughHome sizes it to the bar and
     runs its entrance. The pills are 32dp drawn inside 44dp touch targets, so the card's bottom
     padding and the buttons' top margin are 6dp short of the design's 12dp. -->
<org.chromium.chrome.browser.browser_express_walkthrough.WalkthroughCardFrame
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/walkthrough_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/browser_express_walkthrough_card_bg"
        android:clickable="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <org.chromium.chrome.browser.browser_express_walkthrough.WordRevealLayout
            android:id="@+id/walkthrough_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="-0.01"
                android:lineHeight="22sp"
                android:paddingEnd="5dp"
                android:text="@string/browser_express_walkthrough_search_title"
                android:textColor="@color/browser_express_walkthrough_warm_white"
                android:textSize="18sp"
                tools:ignore="RtlSymmetry" />
        </org.chromium.chrome.browser.browser_express_walkthrough.WordRevealLayout>

        <LinearLayout
            android:id="@+id/walkthrough_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/walkthrough_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineHeight="18sp"
                android:text="@string/browser_express_walkthrough_search_line"
                android:textColor="@color/browser_express_walkthrough_text_78"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/walkthrough_features"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:lineHeight="16sp"
                android:text="@string/browser_express_walkthrough_search_features"
                android:textColor="@color/browser_express_walkthrough_text_56"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- The hero tile. Its 22dp glow is drawn inside the frame's own margin, which the
             negative margins hand back: 12dp from the lines above and the buttons below. -->
        <org.chromium.chrome.browser.browser_express_walkthrough.HeroOutlineFrame
            android:id="@+id/walkthrough_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-22dp"
            android:layout_marginTop="-10dp"
            android:layout_marginEnd="-22dp"
            android:layout_marginBottom="-22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/browser_express_walkthrough_hero_tile_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/browser_express_walkthrough_icon_tile_bg"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_browser_express_walkthrough_reels" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/walkthrough_hero_eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.12"
                        android:lineHeight="13sp"
                        android:text="@string/browser_express_walkthrough_search_eyebrow"
                        android:textColor="@color/browser_express_walkthrough_wasabi"
                        android:textSize="10.5sp"
                        tools:ignore="SmallSp" />

                    <TextView
                        android:id="@+id/walkthrough_hero_line"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01"
                        android:lineHeight="22sp"
                        android:text="@string/browser_express_walkthrough_search_hero"
                        android:textColor="@color/browser_express_walkthrough_warm_white"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </org.chromium.chrome.browser.browser_express_walkthrough.HeroOutlineFrame>

        <LinearLayout
            android:id="@+id/walkthrough_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/walkthrough_secondary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingHorizontal="10dp"
                android:text="@string/browser_express_walkthrough_skip"
                android:textColor="@color/browser_express_walkthrough_text_68"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/walkthrough_primary"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/browser_express_walkthrough_primary_bg"
                android:drawablePadding="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:text="@string/browser_express_walkthrough_reveal"
                android:textColor="@color/browser_express_walkthrough_ink"
                android:textSize="13sp"
                app:drawableEndCompat="@drawable/ic_browser_express_walkthrough_chevron" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/walkthrough_caret"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@color/browser_express_walkthrough_ink"
        android:importantForAccessibility="no" />
</org.chromium.chrome.browser.browser_express_walkthrough.WalkthroughCardFrame>
