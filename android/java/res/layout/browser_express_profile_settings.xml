<!-- The reader's own Profile (design handoff "Profile page"): a nav bar, who they are, their
     three points and a short menu. BrowserExpressProfilePreferences fills it in and plays the
     return-visit count-up. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browser_express_profile_page_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="12dp">

                <ImageButton
                    android:id="@+id/profile_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/browser_express_profile_back"
                    android:src="@drawable/ic_browser_express_profile_back"
                    app:tint="@color/browser_express_profile_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif"
                    android:text="@string/browser_express_profile_nav_title"
                    android:textColor="@color/browser_express_profile_text_primary"
                    android:textFontWeight="600"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/profile_more"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/browser_express_profile_more"
                    android:src="@drawable/ic_browser_express_profile_more"
                    app:tint="@color/browser_express_profile_text_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- The ring lies just outside the 64dp picture, as the design's shadow does, so its
                     frame overhangs the row by its width. -->
                <FrameLayout
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_margin="-1dp"
                    android:background="@drawable/browser_express_profile_avatar_ring">

                    <ImageView
                        android:id="@+id/profile_avatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/browser_express_post_avatar_placeholder" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:lineHeight="25sp"
                        android:maxLines="1"
                        android:textColor="@color/browser_express_profile_text_primary"
                        android:textFontWeight="700"
                        android:textSize="21sp"
                        tools:text="Arjun Mehta" />

                    <TextView
                        android:id="@+id/profile_handle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:lineHeight="18sp"
                        android:maxLines="1"
                        android:textColor="@color/browser_express_profile_text_meta"
                        android:textSize="14sp"
                        tools:text="\@arjunmehta" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/profile_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/browser_express_profile_edit_pill_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_browser_express_profile_edit"
                        app:tint="@color/browser_express_profile_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif"
                        android:text="@string/browser_express_profile_edit"
                        android:textColor="@color/browser_express_profile_text_primary"
                        android:textFontWeight="600"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/profile_karma"
                    layout="@layout/browser_express_profile_stat_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/profile_taste"
                    layout="@layout/browser_express_profile_stat_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <include
                    android:id="@+id/profile_cred"
                    layout="@layout/browser_express_profile_stat_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profile_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/browser_express_profile_card_bg"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/profile_menu_youtube"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_browser_express_profile_youtube"
                        app:tint="@color/browser_express_profile_menu_icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/browser_express_profile_menu_youtube"
                        android:textColor="@color/browser_express_profile_text_primary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_browser_express_profile_chevron"
                        app:tint="@color/browser_express_profile_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="56dp"
                    android:background="@color/browser_express_profile_divider" />

                <LinearLayout
                    android:id="@+id/profile_menu_referral"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_browser_express_profile_referral"
                        app:tint="@color/browser_express_profile_menu_icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/be_referral"
                        android:textColor="@color/browser_express_profile_text_primary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_browser_express_profile_chevron"
                        app:tint="@color/browser_express_profile_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="56dp"
                    android:background="@color/browser_express_profile_divider" />

                <LinearLayout
                    android:id="@+id/profile_menu_logout"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_browser_express_profile_logout"
                        app:tint="@color/browser_express_profile_danger" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="@string/be_logout"
                        android:textColor="@color/browser_express_profile_danger"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_browser_express_profile_chevron"
                        app:tint="@color/browser_express_profile_chevron" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- "✓ Profile updated", back from a save in Edit profile (design handoff "Edit profile"
         §7): 36dp above the bottom for 2.4s. -->
    <TextView
        android:id="@+id/profile_updated_toast"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="36dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/browser_express_edit_profile_toast_bg"
        android:drawablePadding="8dp"
        android:elevation="6dp"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="@string/browser_express_edit_profile_saved"
        android:textColor="@color/browser_express_edit_profile_toast_ink"
        android:textFontWeight="500"
        android:textSize="14sp"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_browser_express_edit_profile_toast_check"
        app:drawableTint="@color/browser_express_edit_profile_toast_check" />
</FrameLayout>
