<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    android:id="@+id/browser_express_profile_settings"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/be_background_black"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layout_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        android:paddingHorizontal="10sp"
        android:paddingVertical="4sp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:background="@drawable/profile_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp">

                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="60dp"
                    android:paddingBottom="10dp"
                    android:baselineAligned="false">

                    <TextView
                        android:id="@+id/browser_express_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/content_color"
                        android:textSize="18sp"
                        android:paddingTop="8dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/browser_express_full_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/content_color"
                        android:textSize="14sp"
                        android:paddingVertical="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/be_views"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textColor="@color/gold_color"
                            android:paddingBottom="32dp"
                            android:drawablePadding="4dp"
                            android:textSize="36sp"
                            app:drawableEndCompat="@drawable/xp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_image_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal">

                 <ImageView
                    android:id="@+id/avatar_image_2"
                    android:src="@drawable/btn_toolbar_profile"
                    android:layout_width="100dp"
                    app:layout_constraintEnd_toEndOf="@+id/profile_image_button"
                    app:layout_constraintStart_toStartOf="@+id/profile_image_button"
                    app:layout_constraintTop_toTopOf="@+id/profile_image_button"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    android:layout_marginTop="15dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                    />

                <!-- <ImageView
                    android:id="@+id/edit_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/edit_image"
                    android:layout_gravity="bottom|end"
                    app:layout_constraintBottom_toBottomOf="@id/avatar_image_2"
                    app:layout_constraintEnd_toEndOf="@id/avatar_image_2"
                    android:layout_margin="6dp"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                    android:background="@drawable/circular_background_edit_icon" /> -->
            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/profile_sub_bg"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/be_likes_received"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    app:drawableStartCompat="@drawable/fire"
                    android:gravity="center"
                    android:textColor="@color/content_color"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/likes_received"
                    android:textColor="@color/content_color"
                    android:textSize="12sp"/>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#CCCCCC"
                android:layout_marginHorizontal="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/be_likes_given"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:drawableStartCompat="@drawable/gold"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:textColor="@color/content_color"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="6sp"
                    android:text="@string/likes_given"
                    android:textColor="@color/content_color"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:background="@drawable/edit_profile"
                android:layout_height="24sp"
                android:layout_width="24sp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:layout_marginEnd="2sp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/edit_profile_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:gravity="start|center_vertical"
                android:textColor="@color/content_color"
                android:drawableTint="@color/content_color"
                android:text="@string/be_edit_profile" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:background="@drawable/activity_feed"
                android:layout_height="24sp"
                android:layout_width="24sp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:layout_marginEnd="2sp"
                android:layout_marginStart="4sp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/activity_feed_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:gravity="start|center_vertical"
                android:textColor="@color/content_color"
                android:drawableTint="@color/content_color"
                android:text="@string/be_activity_feed" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <ImageView
                android:background="@drawable/youtube"
                android:layout_height="24sp"
                android:layout_width="24sp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:layout_marginEnd="2sp"
                android:layout_marginStart="4sp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/youtube_premium_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:gravity="start|center_vertical"
                android:textColor="@color/content_color"
                android:drawableTint="@color/content_color"
                android:text="@string/be_youtube" />

        </LinearLayout>

