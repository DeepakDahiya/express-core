<!-- Sign-in, steps 2 and 3: enter the SMS code, then the "all set" confirmation, which replaces
     the code panel in place once the number is verified. -->
<ScrollView
    android:id="@+id/browser_express_otp_verify_settings"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browser_express_signin_background"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layout_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp">

            <TextView
                style="@style/BrowserExpressSignin.Wordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="@string/browser_express_signin_wordmark" />

            <FrameLayout
                android:id="@+id/btn_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end"
                android:background="@drawable/browser_express_signin_close_bg"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/browser_express_close">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_browser_express_signin_close" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/browser_express_signin_verify_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/BrowserExpressSignin.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="45dp"
                android:text="@string/browser_express_signin_verify_eyebrow" />

            <TextView
                style="@style/BrowserExpressSignin.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityHeading="true"
                android:text="@string/browser_express_signin_verify_headline" />

            <!-- "Enter the N-digit code sent to <masked number>", filled in by the fragment. -->
            <TextView
                android:id="@+id/browser_express_otp_phone"
                style="@style/BrowserExpressSignin.Description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp" />

            <TextView
                android:id="@+id/btn_change_phone"
                style="@style/BrowserExpressSignin.Link"
                android:text="@string/browser_express_signin_edit_number" />

            <FrameLayout
                android:id="@+id/otp_boxes_container"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="13dp"
                android:background="@color/browser_express_signin_code_row_background"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/otp_digit_1"
                        style="@style/BrowserExpressSignin.CodeDigit"
                        android:layout_width="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/otp_digit_2"
                        style="@style/BrowserExpressSignin.CodeDigit"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:id="@+id/otp_digit_3"
                        style="@style/BrowserExpressSignin.CodeDigit"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp" />

                    <TextView
                        android:id="@+id/otp_digit_4"
                        style="@style/BrowserExpressSignin.CodeDigit"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <!-- Receives the typing, paste and SMS / autofill input; the boxes above only
                     mirror it. -->
                <EditText
                    android:id="@+id/browser_express_otp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="smsOTPCode"
                    android:background="@android:color/transparent"
                    android:cursorVisible="false"
                    android:digits="0123456789"
                    android:hint="@string/enter_otp"
                    android:importantForAutofill="yes"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:padding="0dp"
                    android:textColor="@android:color/transparent"
                    android:textColorHint="@android:color/transparent"
                    android:textCursorDrawable="@null" />
            </FrameLayout>

            <!-- Holds its line even when empty (INVISIBLE) so the button below does not jump. -->
            <TextView
                android:id="@+id/login_error_message"
                style="@style/BrowserExpressSignin.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="invisible" />

            <FrameLayout
                android:id="@+id/btn_verify"
                style="@style/BrowserExpressSignin.PrimaryButton"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/btn_verify_text"
                    style="@style/BrowserExpressSignin.PrimaryButtonLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/browser_express_signin_verify" />
            </FrameLayout>

            <TextView
                android:id="@+id/btn_resend_otp"
                style="@style/BrowserExpressSignin.Link"
                android:layout_marginTop="13dp"
                android:text="@string/browser_express_signin_resend" />

            <TextView
                style="@style/BrowserExpressSignin.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/browser_express_signin_code_help" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:background="@drawable/browser_express_signin_card_bg"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="23dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_browser_express_signin_chat" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BrowserExpressSignin.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/browser_express_signin_conversation_title" />

                    <TextView
                        style="@style/BrowserExpressSignin.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/browser_express_signin_conversation_description" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_skip"
                style="@style/BrowserExpressSignin.Skip"
                android:layout_marginTop="24dp"
                android:text="@string/browser_express_signin_skip_verify" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/browser_express_signin_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="78dp"
                android:background="@drawable/browser_express_signin_success_mark_bg">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_browser_express_signin_check" />
            </FrameLayout>

            <TextView
                android:id="@+id/browser_express_signin_success_headline"
                style="@style/BrowserExpressSignin.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="41dp"
                android:accessibilityHeading="true"
                android:accessibilityLiveRegion="polite"
                android:lineHeight="41sp"
                android:textSize="30sp" />

            <TextView
                style="@style/BrowserExpressSignin.Description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:lineHeight="22sp"
                android:text="@string/browser_express_signin_success_description"
                android:textSize="16sp" />

            <FrameLayout
                android:id="@+id/btn_start_browsing"
                style="@style/BrowserExpressSignin.PrimaryButton"
                android:layout_marginTop="43dp">

                <TextView
                    style="@style/BrowserExpressSignin.PrimaryButtonLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/browser_express_signin_start_browsing" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="54dp"
                android:background="@drawable/browser_express_signin_card_bg"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="13dp"
                android:paddingEnd="16dp"
                android:paddingBottom="23dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_browser_express_signin_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/BrowserExpressSignin.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/browser_express_signin_choice_title" />

                    <TextView
                        style="@style/BrowserExpressSignin.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/browser_express_signin_choice_description" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
