<!-- YouTube free-access sheet (Figma "Extend · Light" 1:8670 / "Extend · Dark" 1:8589): the
     YouTube mark, how long free access lasts, what referrals have earned and the refer button.
     The sheet surface comes from BrowserExpressYouTubePremiumSheetTheme. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Glow behind the logo (dark design only; transparent in light). A 250dp disc squashed to
         the design's 250 × 140 ellipse, centred on the logo. -->
    <View
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="@drawable/browser_express_yt_premium_glow"
        android:importantForAccessibility="no"
        android:scaleY="0.56"
        android:translationY="-80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="22dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/browser_express_yt_premium_handle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_browser_express_youtube_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="-0.02"
                android:text="@string/youtube_premium_brand"
                android:textColor="@color/browser_express_yt_premium_text"
                android:textFontWeight="700"
                android:textSize="21sp" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_browser_express_premium_star" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="@string/youtube_premium_title"
            android:textColor="@color/browser_express_yt_premium_text"
            android:textFontWeight="700"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/premium_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/browser_express_yt_premium_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/browser_express_yt_premium_accent"
            android:visibility="gone" />

        <!-- Countdown card. -->
        <LinearLayout
            android:id="@+id/time_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/browser_express_yt_premium_card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/countdown_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/youtube_premium_countdown_label"
                android:textColor="@color/browser_express_yt_premium_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timer_days"
                        style="@style/BrowserExpressYouTubePremiumDigit"
                        tools:text="29" />

                    <TextView
                        style="@style/BrowserExpressYouTubePremiumUnit"
                        android:text="@string/youtube_premium_timer_day" />
                </LinearLayout>

                <TextView style="@style/BrowserExpressYouTubePremiumColon" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timer_hours"
                        style="@style/BrowserExpressYouTubePremiumDigit"
                        tools:text="15" />

                    <TextView
                        style="@style/BrowserExpressYouTubePremiumUnit"
                        android:text="@string/youtube_premium_timer_hour" />
                </LinearLayout>

                <TextView style="@style/BrowserExpressYouTubePremiumColon" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timer_minutes"
                        style="@style/BrowserExpressYouTubePremiumDigit"
                        tools:text="36" />

                    <TextView
                        style="@style/BrowserExpressYouTubePremiumUnit"
                        android:text="@string/youtube_premium_timer_min" />
                </LinearLayout>

                <TextView style="@style/BrowserExpressYouTubePremiumColon" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timer_seconds"
                        style="@style/BrowserExpressYouTubePremiumDigit"
                        tools:text="49" />

                    <TextView
                        style="@style/BrowserExpressYouTubePremiumUnit"
                        android:text="@string/youtube_premium_timer_sec" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- What referrals have earned. -->
        <LinearLayout
            android:id="@+id/stats_layout"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/browser_express_yt_premium_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/referral_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/browser_express_yt_premium_text"
                    android:textFontWeight="700"
                    android:textSize="24sp"
                    tools:text="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/youtube_premium_friends_referred"
                    android:textColor="@color/browser_express_yt_premium_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/browser_express_yt_premium_card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/days_earned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/browser_express_yt_premium_text"
                    android:textFontWeight="700"
                    android:textSize="24sp"
                    tools:text="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/youtube_premium_days_earned"
                    android:textColor="@color/browser_express_yt_premium_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- A TextView rather than a Button: a Button inflates as a MaterialButton here and
             tints over this background. -->
        <TextView
            android:id="@+id/btn_refer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/browser_express_yt_premium_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingVertical="15dp"
            android:text="@string/youtube_premium_refer_button"
            android:textColor="@color/browser_express_yt_premium_button_text"
            android:textFontWeight="700"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Sized to the content, not the parent: an empty view asked to fill its parent would
         claim the whole screen and stretch the sheet. -->
    <org.chromium.chrome.browser.youtube_premium.ConfettiView
        android:id="@+id/confetti_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/content_layout"
        app:layout_constraintEnd_toEndOf="@id/content_layout"
        app:layout_constraintStart_toStartOf="@id/content_layout"
        app:layout_constraintTop_toTopOf="@id/content_layout" />

    <!-- Auto-close countdown (on YouTube only). -->
    <FrameLayout
        android:id="@+id/timer_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/timer_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="100"
            android:progressDrawable="@drawable/circular_timer_progress"
            android:rotation="-90" />

        <TextView
            android:id="@+id/timer_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif"
            android:textColor="@color/browser_express_yt_premium_text"
            android:textFontWeight="700"
            android:textSize="12sp"
            tools:text="10s" />
    </FrameLayout>

    <!-- Close, where the sheet doesn't close itself (new tab page, profile). -->
    <ImageView
        android:id="@+id/close_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close"
        android:padding="10dp"
        android:src="@drawable/btn_close"
        android:visibility="gone"
        app:tint="@color/browser_express_yt_premium_muted" />
</androidx.constraintlayout.widget.ConstraintLayout>
