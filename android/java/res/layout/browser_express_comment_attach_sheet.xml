<!-- What can go on a comment (Figma "Attachment picker sheet", 36:1720): photo, camera, video,
     voice note, GIF and document. CommentAttachmentSheet reports the choice to the comments
     sheet, which runs it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/browser_express_comment_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/browser_express_attach_title"
                android:textColor="@color/browser_express_comment_sheet_title"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/browser_express_attach_subtitle"
                android:textColor="@color/browser_express_comment_sheet_subtitle"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/sheet_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/browser_express_comment_sheet_close_bg"
            android:contentDescription="@string/browser_express_comment_close"
            android:src="@drawable/ic_browser_express_comment_sheet_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

    <LinearLayout
        android:id="@+id/attach_photo"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_browser_express_attach_photo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/browser_express_attach_photo"
            android:textColor="@color/browser_express_comment_sheet_label"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/attach_camera"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_browser_express_attach_camera" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/browser_express_attach_camera"
            android:textColor="@color/browser_express_comment_sheet_label"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/attach_video"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_browser_express_attach_video" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/browser_express_attach_video"
            android:textColor="@color/browser_express_comment_sheet_label"
            android:textSize="12sp" />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

    <LinearLayout
        android:id="@+id/attach_voice"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_browser_express_attach_voice" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/browser_express_attach_voice"
            android:textColor="@color/browser_express_comment_sheet_label"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/attach_gif"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/ic_browser_express_attach_gif">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:importantForAccessibility="no"
                android:text="@string/browser_express_attach_gif"
                android:textColor="#FFB67A00"
                android:textSize="13sp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/browser_express_attach_gif"
            android:textColor="@color/browser_express_comment_sheet_label"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/attach_document"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_browser_express_attach_document" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/browser_express_attach_document"
            android:textColor="@color/browser_express_comment_sheet_label"
            android:textSize="12sp" />
    </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:text="@string/browser_express_attach_footnote"
        android:textColor="@color/browser_express_comment_sheet_footnote"
        android:textSize="11sp" />
</LinearLayout>
