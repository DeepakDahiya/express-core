<!-- Walkthrough step 3, "SEE WHAT EVERYONE IS SAYING" (design_handoff_walkthrough README §3): the
     hero card that rises in above the featured post. WalkthroughHome sizes it to the post's card
     and runs its entrance; tapping it dives in like the primary button. -->
<org.chromium.chrome.browser.browser_express_walkthrough.WalkthroughCardFrame
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <org.chromium.chrome.browser.browser_express_walkthrough.HeroOutlineFrame
        android:id="@+id/walkthrough_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/browser_express_walkthrough_hero_card_bg"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/browser_express_walkthrough_icon_tile_small_bg"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/ic_browser_express_walkthrough_reactions" />

                <TextView
                    android:id="@+id/walkthrough_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:lineHeight="13sp"
                    android:text="@string/browser_express_walkthrough_post_eyebrow"
                    android:textColor="@color/browser_express_walkthrough_wasabi"
                    android:textSize="10.5sp"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <org.chromium.chrome.browser.browser_express_walkthrough.WordRevealLayout
                android:id="@+id/walkthrough_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:lineHeight="26sp"
                    android:paddingEnd="6dp"
                    android:text="@string/browser_express_walkthrough_post_title"
                    android:textColor="@color/browser_express_walkthrough_warm_white"
                    android:textSize="21sp"
                    tools:ignore="RtlSymmetry" />
            </org.chromium.chrome.browser.browser_express_walkthrough.WordRevealLayout>

            <TextView
                android:id="@+id/walkthrough_line"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:lineHeight="19sp"
                android:text="@string/browser_express_walkthrough_post_line"
                android:textColor="@color/browser_express_walkthrough_text_72"
                android:textSize="13.5sp" />

            <LinearLayout
                android:id="@+id/walkthrough_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/walkthrough_secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="44dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/browser_express_walkthrough_pick_another"
                    android:textColor="@color/browser_express_walkthrough_text_70"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/walkthrough_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/browser_express_walkthrough_primary_bg"
                    android:drawablePadding="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:text="@string/browser_express_walkthrough_dive_in"
                    android:textColor="@color/browser_express_walkthrough_ink"
                    android:textSize="13sp"
                    app:drawableEndCompat="@drawable/ic_browser_express_walkthrough_chevron" />
            </LinearLayout>
        </LinearLayout>
    </org.chromium.chrome.browser.browser_express_walkthrough.HeroOutlineFrame>
</org.chromium.chrome.browser.browser_express_walkthrough.WalkthroughCardFrame>
