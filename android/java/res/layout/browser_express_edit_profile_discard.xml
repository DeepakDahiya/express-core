<!-- "Discard changes?" (design handoff "Edit profile" §6): a 300dp dialog over the scrim with
     Keep editing and Discard pills. Centred, it is clear of the system bars without padding. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/edit_profile_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/browser_express_edit_profile_scrim" />

    <LinearLayout
        android:id="@+id/edit_profile_overlay_panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/browser_express_edit_profile_dialog_bg"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineHeight="22sp"
            android:text="@string/browser_express_edit_profile_discard_title"
            android:textColor="@color/browser_express_profile_text_primary"
            android:textFontWeight="600"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineHeight="20sp"
            android:text="@string/browser_express_edit_profile_discard_body"
            android:textColor="@color/browser_express_profile_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/edit_profile_keep_editing"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/browser_express_edit_profile_keep_bg"
                android:fontFamily="sans-serif"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/browser_express_edit_profile_keep_editing"
                android:textColor="@color/browser_express_profile_text_primary"
                android:textFontWeight="600"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/edit_profile_discard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/browser_express_edit_profile_discard_bg"
                android:fontFamily="sans-serif"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="@string/browser_express_edit_profile_discard"
                android:textColor="@color/browser_express_profile_danger"
                android:textFontWeight="600"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
