<!-- Emoji for the message box (Figma "Emoji sheet"): popular ones first, then more. Tapping one
     adds it where the cursor is. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="7dp"
        android:background="@drawable/browser_express_comment_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/emoji_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="@string/browser_express_comment_emoji_title"
            android:textColor="@color/browser_express_comment_sheet_title"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/sheet_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_express_comment_close"
            android:src="@drawable/ic_browser_express_comment_sheet_close" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:text="@string/browser_express_comment_emoji_popular"
        android:textAllCaps="true"
        android:textColor="@color/browser_express_comment_sheet_subtitle"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/emoji_popular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:text="@string/browser_express_comment_emoji_more"
        android:textAllCaps="true"
        android:textColor="@color/browser_express_comment_sheet_subtitle"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/emoji_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:text="@string/browser_express_comment_emoji_footnote"
        android:textColor="@color/browser_express_comment_sheet_footnote"
        android:textSize="12sp" />
</LinearLayout>
