<!-- One emoji in the reaction picker's grid. The design's 32dp cells sit 12dp apart; the cell
     takes the gap too, so the whole row height is a touch target. The size is in dp so large
     font settings can't push a glyph out of its cell; 20dp draws the design's 24px emoji. The
     colour must be opaque: emoji are drawn at the text colour's alpha, and TextView's default
     is the theme's translucent grey, which made every emoji look disabled. -->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:gravity="center"
    android:includeFontPadding="false"
    android:textColor="@color/browser_express_comment_sheet_title"
    android:textSize="20dp"
    tools:ignore="SpUsage" />
