<!-- One category in the reaction picker's jump bar, as in WhatsApp's emoji panel. Selected is
     the section at the top of the list. CommentReactionSheet sets the icon and description. -->
<ImageButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="36dp"
    android:layout_marginHorizontal="2dp"
    android:layout_weight="1"
    android:background="@drawable/browser_express_reaction_picker_tab_bg"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    android:scaleType="center"
    android:tint="@color/browser_express_comment_picker_tab_icon_state"
    tools:ignore="ContentDescription" />
