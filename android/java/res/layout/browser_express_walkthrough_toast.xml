<!-- "All set" (design_handoff_walkthrough README §3, step 4): a 36dp pill with a wasabi tick,
     92dp from the top, after the reader's first swipe. -->
<org.chromium.chrome.browser.browser_express_walkthrough.WalkthroughCardFrame
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/browser_express_walkthrough_toast_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="18sp"
            android:text="@string/browser_express_walkthrough_all_set"
            android:textColor="@color/browser_express_walkthrough_warm_white"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_browser_express_walkthrough_tick" />
    </LinearLayout>
</org.chromium.chrome.browser.browser_express_walkthrough.WalkthroughCardFrame>
