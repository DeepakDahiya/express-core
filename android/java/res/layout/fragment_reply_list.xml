<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:gravity="start|center_vertical"
            android:padding="16dp"
            app:srcCompat="@drawable/ic_back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/replies"
            android:textSize="24sp"
            android:textColor="@color/content_color"
            android:textStyle="bold"/>

    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
		<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <org.chromium.chrome.browser.app.shimmer.ShimmerFrameLayout
                android:id="@+id/skeleton_shimmer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/shimmer_items"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical" />
            </org.chromium.chrome.browser.app.shimmer.ShimmerFrameLayout>

            <LinearLayout
                android:id="@+id/parent_comment_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:background="@color/username_color" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/parent_comment_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never" />
            
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/comment_array1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:layout_gravity="top"
                    visibility="gone"
                    app:srcCompat="@drawable/comment_array"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/top_comment_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/comment_array1"
                    android:src="@drawable/comment_array"
                    android:layout_width="24sp"
                    android:layout_height="24sp"
                    android:layout_marginEnd="4sp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:layout_gravity="top"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/top_comment_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8sp"
                    android:overScrollMode="never" />

            </LinearLayout>
                
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:layout_marginStart="12sp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/comment_array2"
                    android:src="@drawable/comment_array"
                    android:layout_width="24sp"
                    android:layout_height="24sp"
                    android:layout_marginEnd="4sp"
                    android:layout_gravity="top"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_replies"
                    android:layout_width="match_parent"
                    android:layout_weight="1"
                    android:layout_height="0dp"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>
	</androidx.core.widget.NestedScrollView>

</LinearLayout>
