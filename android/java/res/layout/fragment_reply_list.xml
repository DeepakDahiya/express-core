<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browser_express_feed_background"
    android:orientation="vertical">

    <include layout="@layout/browser_express_comment_toolbar" />

    <include layout="@layout/browser_express_comments_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.chromium.chrome.browser.app.shimmer.ShimmerFrameLayout
            android:id="@+id/skeleton_shimmer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/shimmer_items"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />
        </org.chromium.chrome.browser.app.shimmer.ShimmerFrameLayout>
        
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_comments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/be_slide_rows_padding_top"
            android:paddingBottom="8dp"/>

        <LinearLayout
            android:id="@+id/empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/browser_express_comments_empty" />
        </LinearLayout>
        
    </FrameLayout>
</LinearLayout>