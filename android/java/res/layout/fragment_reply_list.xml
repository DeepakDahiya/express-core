<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        tools:ignore="UseCompoundDrawables"> -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:gravity="start|center_vertical"
            android:padding="16dp"
            app:srcCompat="@drawable/ic_back"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/replies"
            android:textSize="24sp"
            android:textColor="@color/set_default_text_color"
            android:textStyle="bold"/>

    <!-- </LinearLayout> -->
    </RelativeLayout>

    <org.chromium.chrome.browser.app.shimmer.ShimmerFrameLayout
        android:id="@+id/skeleton_shimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/shimmer_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />
    </org.chromium.chrome.browser.app.shimmer.ShimmerFrameLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/top_comment_recycler"
        android:layout_width="match_parent"
        android:nestedScrollingEnabled="false"
        android:layout_height="wrap_content"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_replies"
        android:layout_width="match_parent"
        android:layout_weight="1"
        android:layout_height="0dp"
        android:layout_marginStart="16sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5sp"
        android:orientation="vertical"
        android:layout_gravity="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="bottom"
            android:padding="5sp"
            android:weightSum="6">

            <Button
                android:id="@+id/lol_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/lol"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/heart_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/heart"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/cry_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cry"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/fire_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/fire"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/love_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/love"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            <Button
                android:id="@+id/clap_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/clap"
                android:background="@android:color/transparent"
                style="?android:attr/borderlessButtonStyle"
                android:textSize="20sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingVertical="0sp"
                android:paddingHorizontal="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5sp"
            android:layout_gravity="bottom">

            <ImageView
                android:id="@+id/avatar_image"
                android:src="@drawable/btn_toolbar_profile"
                android:layout_width="24sp"
                android:layout_height="24sp"
                android:scaleType="centerCrop"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>

            <EditText
                android:layout_marginStart="54dp"
                android:id="@+id/comment_content_input"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/button_send"
                android:inputType="textMultiLine"
                android:paddingEnd="18dp"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:maxLines="6"
                android:textSize="14sp"
                android:textColor="@color/wallet_text_color"
                android:textColorHint="@color/brave_theme_hint_text"
                android:hint="@string/type_your_comment"
                android:background="@drawable/rounded_edittext"
                tools:ignore="Autofill" />

            <ImageButton android:id="@+id/button_send"
                style="@style/ToolbarButton"
                android:background="@drawable/send"
                android:layout_gravity="center"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="8sp"
                android:visibility="visible"
                android:layout_width="28sp"
                android:layout_height="28sp"
                android:contentDescription="@string/send_comment" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
