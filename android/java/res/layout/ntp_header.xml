<?xml version="1.0" encoding="utf-8"?>
<!-- The new tab page's header row in the post feed (Figma "light-mode" 24:2692 / "dark-mode"
     1:8351): the UGC wordmark, a search box that opens the omnibox and the site shortcuts
     card. PostListAdapter.HeaderViewHolder binds it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/browser_express_feed_background"
      android:gravity="center_horizontal"
      android:orientation="vertical">

      <!-- UGC wordmark at its brand-kit home size (44dp, set by the drawable). -->
      <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:contentDescription="@string/browser_express_name"
            android:src="@drawable/ugc_wordmark" />

      <LinearLayout
            android:id="@+id/ntp_search_box"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/browser_express_ntp_field_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">

            <ImageView
                  android:layout_width="23dp"
                  android:layout_height="24dp"
                  android:importantForAccessibility="no"
                  android:src="@drawable/browser_express_ntp_google_g" />

            <TextView
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="20dp"
                  android:layout_weight="1"
                  android:ellipsize="end"
                  android:fontFamily="sans-serif-medium"
                  android:maxLines="1"
                  android:text="@string/browser_express_ntp_search_hint"
                  android:textColor="@color/browser_express_ntp_on_field"
                  android:textSize="18sp" />

            <ImageButton
                  android:id="@+id/ntp_search_voice"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:background="?attr/selectableItemBackgroundBorderless"
                  android:contentDescription="@string/accessibility_toolbar_btn_mic"
                  android:src="@drawable/ic_browser_express_ntp_mic" />

            <ImageButton
                  android:id="@+id/ntp_search_lens"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:layout_marginStart="8dp"
                  android:background="?attr/selectableItemBackgroundBorderless"
                  android:contentDescription="@string/accessibility_btn_lens_camera"
                  android:src="@drawable/ic_browser_express_ntp_lens" />
      </LinearLayout>

      <!-- Site shortcuts; tiles are added (and spread across) by HeaderViewHolder. -->
      <LinearLayout
            android:id="@+id/top_sites_container"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/browser_express_ntp_sites_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:visibility="gone" />

      <!-- Tutorial video, when the server offers one. -->
      <FrameLayout
            android:id="@+id/tutorial_video_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

      <org.chromium.chrome.browser.app.shimmer.ShimmerFrameLayout
            android:id="@+id/skeleton_shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                  android:id="@+id/shimmer_items"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical" />
      </org.chromium.chrome.browser.app.shimmer.ShimmerFrameLayout>

      <!-- Space above the first post (whose card adds 2dp of its own). -->
      <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />
</LinearLayout>
