<!-- A portrait-video comment as a full-screen reel (Figma "Reel motion / Plus → Add your take
     bubble", 598:4043): the video fills the page; the comment sits at the bottom over a scrim
     (author and time, one line of text, the playback line) and its actions run down a rail on
     the right (reactions, the picker, replies, share, more). Media stays dark in both themes, so
     every colour here is fixed.

     Reuses the view ids of browser_express_comment.xml so CommentListAdapter.CommentHolder binds
     it. Views that exist only to satisfy the holder (the aspect-ratio spacer, the image slot, the
     voice-note row) are present but stay hidden. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/browser_express_media_background">

    <androidx.cardview.widget.CardView
        android:id="@+id/comment_media_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:cardBackgroundColor="@color/browser_express_media_background"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Unused on this layout (the video is full-bleed, not ratio-boxed) but the holder
                 looks it up and reads its parent, so it stays. -->
            <Space
                android:id="@+id/media_aspect_ratio_spacer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- zoom = centre-crop, so a fully vertical video fills the page edge to edge. A
                 squarer one is switched to fit at bind (CommentListAdapter
                 .applyReelResizeMode), and this black background is its letterbox bars. -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/comment_video"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/black"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:resize_mode="zoom"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <ImageView
                android:id="@+id/comment_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/play_pause_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/browser_express_video_viewer_play"
                android:src="@drawable/ic_browser_express_comment_video_play"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:layout_gravity="bottom"
        android:background="@drawable/browser_express_reel_bottom_scrim_bg" />

    <!-- Keeps the rail readable over bright video (Figma "Rail contrast scrim"): drawn by
         ReelRailScrimDrawable, running past the right edge as the design's does. -->
    <View
        android:id="@+id/reel_rail_scrim"
        android:layout_width="154dp"
        android:layout_height="416dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-57dp"
        android:layout_marginBottom="36dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/comment_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="37dp">

        <!-- NEW on a take the reader hasn't seen, above the author (design_handoff_new_takes §4). -->
        <TextView
            android:id="@+id/comment_new_tag"
            style="@style/BrowserExpressCommentNewTag"
            android:layout_height="20dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/browser_express_comment_new_tag_reel_bg"
            android:paddingHorizontal="8dp"
            android:textSize="10.5sp"
            tools:ignore="SmallSp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/avatar_image"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/browser_express_post_avatar_placeholder" />

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxWidth="200dp"
                android:maxLines="1"
                android:textColor="@color/browser_express_reel_author"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/comment_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/browser_express_reel_time"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- One line, as the design sets it, clear of the rail; a tap opens all of it, scrolling
             once it is long (ExpandableCaption). -->
        <ScrollView
            android:id="@+id/comment_content_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="122dp"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <TextView
                android:id="@+id/comment_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:lineHeight="20sp"
                android:maxLines="1"
                android:textColor="@color/browser_express_reel_text"
                android:textSize="15sp" />
        </ScrollView>

        <Button
            android:id="@+id/btn_read_more_comment"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="@string/browser_express_post_more"
            android:textAllCaps="false"
            android:textColor="@color/browser_express_reel_time"
            android:textSize="12sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/posting_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/failed_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/post_failed"
            android:textColor="@android:color/holo_red_light"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Never shown on a reel (a video comment has no voice note), but the holder looks
             these views up unconditionally. -->
        <LinearLayout
            android:id="@+id/comment_audio_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:ignore="UseCompoundDrawables">

            <ImageButton
                android:id="@+id/audio_play_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@null"
                android:contentDescription="@string/be_audio_play" />

            <TextView
                android:id="@+id/audio_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- The rail (44dp wide, 12dp from the edge): up to three reaction chips, the picker, a
         divider, then replies, share and more. Anchored to the bottom so it grows upward when
         the comment has fewer reactions. -->
    <LinearLayout
        android:id="@+id/action_items"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="36dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reaction_chip_1"
            style="@style/BrowserExpressReelRailChip" />

        <TextView
            android:id="@+id/reaction_chip_2"
            style="@style/BrowserExpressReelRailChip"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/reaction_chip_3"
            style="@style/BrowserExpressReelRailChip"
            android:layout_marginTop="8dp" />

        <!-- The smiley sits 5dp in from the chips' right edge, as designed. -->
        <ImageButton
            android:id="@+id/btn_add_reaction"
            android:layout_width="38.4dp"
            android:layout_height="28dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_express_comment_add_reaction"
            android:paddingStart="0dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="2dp"
            android:scaleType="fitEnd"
            android:src="@drawable/ic_browser_express_reel_add_reaction" />

        <View
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/browser_express_reel_rail_divider" />

        <!-- The icon over the reply count (blank while there are none). -->
        <TextView
            android:id="@+id/btn_reply"
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:drawablePadding="2dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:lineHeight="20sp"
            android:maxLines="1"
            android:textColor="@color/browser_express_reel_rail_label"
            android:textSize="12sp"
            app:drawableTopCompat="@drawable/ic_browser_express_reel_reply" />

        <ImageButton
            android:id="@+id/btn_comment_share"
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_express_comment_menu_share"
            android:scaleType="center"
            android:src="@drawable/ic_browser_express_reel_share" />

        <ImageButton
            android:id="@+id/btn_comment_more"
            android:layout_width="44dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_express_comment_more"
            android:scaleType="center"
            android:src="@drawable/ic_browser_express_reel_more" />
    </LinearLayout>

    <!-- "2×" while the reader holds the video (either side). -->
    <include
        layout="@layout/browser_express_fast_forward_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp" />

    <!-- Playback, under the comment (Figma "Reel progress"): the 2dp line sits in a 20dp strip
         so it can be dragged to move through the video; the thumb shows while dragging. -->
    <SeekBar
        android:id="@+id/video_progress"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/browser_express_video_viewer_position"
        android:maxHeight="2dp"
        android:minHeight="2dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:progressDrawable="@drawable/browser_express_reel_progress"
        android:splitTrack="false"
        android:thumb="@drawable/browser_express_reel_thumb"
        android:visibility="gone" />
</FrameLayout>
