<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/golden_youtube_shortcut_sheet_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <View
        android:layout_width="54dp"
        android:layout_height="5dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/golden_youtube_shortcut_handle" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="8dp"
        android:contentDescription="@string/youtube"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/golden_youtube_shortcut_gift" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/golden_youtube_shortcut_title"
            android:textColor="@color/browser_express_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <org.chromium.chrome.browser.youtube_premium.GoldenYouTubeGradientTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/golden_youtube_shortcut_premium_youtube"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/golden_youtube_shortcut_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:text="@string/golden_youtube_shortcut_body"
            android:textColor="@color/golden_youtube_shortcut_body_text"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/golden_youtube_shortcut_feature_bg"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/golden_youtube_shortcut_icon_badge_red"
                    android:importantForAccessibility="no">

                    <TextView
                        android:id="@+id/golden_youtube_shortcut_ads_icon_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/golden_youtube_shortcut_ads_icon"
                        android:textColor="@color/browser_express_text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/ic_golden_youtube_shortcut_no_ads" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    tools:ignore="NestedWeights">

                    <TextView
                        android:id="@+id/golden_youtube_shortcut_ad_free_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/golden_youtube_shortcut_ad_free_title"
                        android:textColor="@color/golden_youtube_shortcut_title_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/golden_youtube_shortcut_ad_free_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:text="@string/golden_youtube_shortcut_ad_free_body"
                        android:textColor="@color/golden_youtube_shortcut_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:background="@color/golden_youtube_shortcut_feature_stroke" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/golden_youtube_shortcut_icon_badge_purple"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    app:srcCompat="@drawable/ic_golden_youtube_shortcut_headphones" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    tools:ignore="NestedWeights">

                    <TextView
                        android:id="@+id/golden_youtube_shortcut_background_play_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/golden_youtube_shortcut_background_play_title"
                        android:textColor="@color/golden_youtube_shortcut_title_text"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/golden_youtube_shortcut_background_play_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:text="@string/golden_youtube_shortcut_background_play_body"
                        android:textColor="@color/golden_youtube_shortcut_secondary_text"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_add_golden_youtube_shortcut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/golden_youtube_shortcut_cta_bg"
            android:clickable="true"
            android:contentDescription="@string/golden_youtube_shortcut_add"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_golden_youtube_shortcut_plus" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="@string/golden_youtube_shortcut_add"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_golden_youtube_shortcut_later"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/golden_youtube_shortcut_later"
            android:textColor="@color/golden_youtube_shortcut_later_text"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
