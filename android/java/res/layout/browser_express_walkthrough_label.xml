<!-- Walkthrough step 4 (design_handoff_walkthrough README §3): the card under the ringed hashtag
     and stream position, its caret pointing up at them. No buttons: the reader's first swipe
     ends it. The title is one line and ellipsizes a long hashtag. -->
<org.chromium.chrome.browser.browser_express_walkthrough.WalkthroughCardFrame
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/walkthrough_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/browser_express_walkthrough_card_bg"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/walkthrough_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineHeight="20sp"
            android:maxLines="1"
            android:textColor="@color/browser_express_walkthrough_warm_white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/walkthrough_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:lineHeight="18sp"
            android:maxLines="1"
            android:text="@string/browser_express_walkthrough_video_line"
            android:textColor="@color/browser_express_walkthrough_text_70"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:id="@+id/walkthrough_caret"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@color/browser_express_walkthrough_ink"
        android:importantForAccessibility="no" />
</org.chromium.chrome.browser.browser_express_walkthrough.WalkthroughCardFrame>
