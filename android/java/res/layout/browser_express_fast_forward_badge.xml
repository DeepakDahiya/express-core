<!-- "2× ▶▶", shown while the reader holds the right half of a video (HoldToFastForward). Media
     stays dark in both themes, so the colours are fixed. -->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/video_fast_forward_badge"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:accessibilityLiveRegion="polite"
    android:background="@drawable/browser_express_fast_forward_badge_bg"
    android:contentDescription="@string/browser_express_video_fast_forward_description"
    android:drawablePadding="4dp"
    android:fontFamily="sans-serif-medium"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp"
    android:text="@string/browser_express_video_fast_forward"
    android:textColor="@android:color/white"
    android:textSize="14sp"
    android:visibility="gone"
    android:drawableEnd="@drawable/ic_browser_express_fast_forward" />
