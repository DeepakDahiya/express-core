     Single comment preview card — mirrors browser_express_comment.xml but without
     vote/action controls; used in the rising comments preview animation. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/comment_preview_bg">

    <ImageView
        android:id="@+id/preview_avatar"
        android:layout_width="24sp"
        android:layout_height="24sp"
        android:layout_marginEnd="4sp"
        android:src="@drawable/btn_toolbar_profile"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4sp">

        <TextView
            android:id="@+id/preview_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/username_color"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/preview_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/content_color"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginVertical="4sp" />

    </LinearLayout>

</LinearLayout>
