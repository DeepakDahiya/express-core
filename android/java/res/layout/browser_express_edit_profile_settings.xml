<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/browser_express_edit_profile_settings"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <LinearLayout
        android:id="@+id/layout_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_image_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/avatar_image_1"
                android:src="@drawable/btn_toolbar_profile"
                android:layout_width="120dp"
                app:layout_constraintEnd_toEndOf="@+id/profile_image_button"
                app:layout_constraintStart_toStartOf="@+id/profile_image_button"
                app:layout_constraintTop_toTopOf="@+id/profile_image_button"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:layout_marginTop="15dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:background="@drawable/circular_background" />
            <ImageView
                android:id="@+id/edit_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/edit_image"
                android:layout_gravity="bottom|end"
                app:layout_constraintBottom_toBottomOf="@id/avatar_image_1"
                app:layout_constraintEnd_toEndOf="@id/avatar_image_1"
                android:layout_margin="6dp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:background="@drawable/circular_background_edit_icon" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <EditText
            android:id="@+id/be_username"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:drawableStart="@drawable/person"
            android:drawablePadding="10dp"
            android:background="@drawable/rounded_wallet_edittext"
            android:hint="@string/enter_your_username"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingEnd="18dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textCursorDrawable="@null"
            android:textSize="14sp"
            android:textColor="@color/wallet_text_color"
            android:textColorHint="@color/brave_theme_hint_text" />

        <EditText
            android:id="@+id/be_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:drawableStart="@drawable/person"
            android:drawablePadding="10dp"
            android:background="@drawable/rounded_wallet_edittext"
            android:hint="@string/enter_your_name"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingEnd="18dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textCursorDrawable="@null"
            android:textSize="14sp"
            android:textColor="@color/wallet_text_color"
            android:textColorHint="@color/brave_theme_hint_text" />

        <EditText
            android:id="@+id/be_email"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:drawableStart="@drawable/mail"
            android:drawablePadding="10dp"
            android:background="@drawable/rounded_wallet_edittext"
            android:hint="@string/enter_your_email"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress"
            android:paddingEnd="18dp"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textCursorDrawable="@null"
            android:textSize="14sp"
            android:textColor="@color/wallet_text_color"
            android:textColorHint="@color/brave_theme_hint_text" />

        <Button
            android:id="@+id/btn_edit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/orange_rounded_bg"
            app:backgroundTint="@null"
            android:text="@string/browser_express_edit_profile_button_title"
            android:textAllCaps="false"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:paddingVertical="20dp"
            android:paddingHorizontal="20dp"
            style="?android:attr/borderlessButtonStyle"/>

        <TextView
            android:id="@+id/error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal"
            android:text=""
            android:textColor="@color/browser_express_error_color"
            android:textSize="12sp"
            android:textStyle="normal"
            android:visibility="visible"/>
    </LinearLayout>
</ScrollView>
