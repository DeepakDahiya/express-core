<!-- Under the comments title: how far through the comments the reader is (a 3dp line and
     "12 / 87") and the chip naming what the comments are on. Both start hidden; the page shows
     them once it knows what to put there. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/comments_depth_row"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="2dp"
        android:paddingHorizontal="16dp"
        android:visibility="invisible">

        <ProgressBar
            android:id="@+id/comments_depth"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="56dp"
            android:importantForAccessibility="no"
            android:max="1000"
            android:progressDrawable="@drawable/browser_express_comments_depth_progress" />

        <TextView
            android:id="@+id/comments_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="@color/browser_express_comments_position"
            android:textSize="10sp"
            tools:ignore="SmallSp" />
    </FrameLayout>

    <!-- What the comments are on (Figma "Source Post Chips", 89:1322): the post or page on the
         comments page, the comment being answered on a replies page. A photo or video shows as a
         40dp thumbnail beside the author line (a video's with a play mark); a voice note as a
         compact player under it. SourceChip picks the state. -->
    <LinearLayout
        android:id="@+id/comments_source_chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/browser_express_comments_chip_bg"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/comments_source_thumb_frame"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/browser_express_comments_chip_thumb_bg"
            android:visibility="gone">

            <ImageView
                android:id="@+id/comments_source_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/comments_source_play"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_browser_express_comments_chip_play"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Figma "Express/Author": avatar and name on the left, the age on the right. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/comments_source_avatar"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/browser_express_post_avatar_placeholder" />

                <TextView
                    android:id="@+id/comments_source_author"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/browser_express_post_author"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/comments_source_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/browser_express_post_time"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/comments_source_text"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="@color/browser_express_post_caption"
                android:textSize="13sp" />

            <!-- Figma "Compact Audio Player". -->
            <LinearLayout
                android:id="@+id/comments_source_audio"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/browser_express_comments_chip_audio_bg"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/comments_source_audio_play"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/browser_express_comments_chip_audio_button_bg"
                    android:contentDescription="@string/be_audio_play"
                    android:scaleType="center"
                    android:src="@drawable/ic_browser_express_comments_chip_audio_play" />

                <ImageButton
                    android:id="@+id/comments_source_audio_pause"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/browser_express_comments_chip_audio_button_bg"
                    android:contentDescription="@string/be_audio_pause"
                    android:scaleType="center"
                    android:src="@drawable/ic_browser_express_comments_chip_audio_pause" />

                <SeekBar
                    android:id="@+id/comments_source_audio_seek"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:max="1000"
                    android:maxHeight="4dp"
                    android:minHeight="4dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progressDrawable="@drawable/browser_express_post_audio_progress"
                    android:splitTrack="false"
                    android:thumb="@null" />

                <TextView
                    android:id="@+id/comments_source_audio_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/browser_express_comments_chip_audio_time"
                    android:textFontWeight="600"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
