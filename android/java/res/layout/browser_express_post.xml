<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/post_layout"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    app:cardCornerRadius="6dp"
    app:contentPadding="8sp"
    android:layout_margin="10sp">

    <LinearLayout
        android:id="@+id/twitter_post_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/twitter_profile_picture"
                android:src="@drawable/btn_toolbar_profile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="centerCrop"
                android:layout_gravity="center"
                android:layout_marginEnd="8sp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:adjustViewBounds="true" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/twitter_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/news_settings_title_color"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="bold" />
            </LinearLayout>
            <ImageView
                android:id="@+id/x_logo"
                android:src="@drawable/x_logo"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop"
                android:layout_gravity="top"
                android:visibility="gone"
                android:layout_marginStart="8sp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:adjustViewBounds="true" />
            <ImageView
                android:id="@+id/instagram_logo"
                android:src="@drawable/instagram_logo"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:scaleType="centerCrop"
                android:layout_gravity="top"
                android:visibility="gone"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:layout_marginStart="8sp"
                android:adjustViewBounds="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/twitter_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/news_settings_title_color"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_read_more_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/be_read_more"
            android:background="@android:color/transparent"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/set_default_text_color"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2sp"
            android:paddingHorizontal="0dp"
            android:textAllCaps="false"
            android:visibility="gone"
            android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

        <androidx.cardview.widget.CardView
            android:id="@+id/twitter_media_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:cardCornerRadius="12dp"
            app:contentPadding="0sp"
            android:visibility="gone"
            android:layout_margin="0dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/twitter_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/loading_image"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                    android:adjustViewBounds="true"
                    android:visibility="gone"
                    android:scaleType="centerCrop"/>
                <VideoView
                    android:id="@+id/twitter_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:visibility="gone"/>
                <ImageButton
                    android:id="@+id/twitter_play_button"
                    android:layout_width="75sp"
                    android:layout_height="75sp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:background="@drawable/play_video"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                    android:scaleType="centerCrop" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/news_settings_title_color"
        android:layout_marginBottom="4sp"
        app:cardCornerRadius="12dp">
        <ImageView
            android:id="@+id/post_image"
            android:src="@drawable/loading_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:maxHeight="200sp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2sp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/publisher_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/news_settings_title_color"
            android:textSize="11sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/news_settings_title_color"
        android:layout_marginVertical="2sp"
        android:textStyle="bold"
        android:textSize="14sp"/>
    <TextView
        android:id="@+id/post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/news_settings_title_color"
        android:layout_marginTop="4sp"
        android:visibility="gone"
        android:textSize="11sp"/>
    <Button
        android:id="@+id/btn_read_more_post2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/be_read_more"
        android:background="@android:color/transparent"
        style="?android:attr/borderlessButtonStyle"
        android:textColor="@color/set_default_text_color"
        android:textSize="11sp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingVertical="2sp"
        android:paddingHorizontal="0dp"
        android:textAllCaps="false"
        android:visibility="gone"
        android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />
    <Button
        android:id="@+id/btn_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        style="?android:attr/borderlessButtonStyle"
        android:textColor="@color/browser_express_blue_color"
        android:textSize="14sp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingVertical="6sp"
        android:paddingHorizontal="0dp"
        android:textAllCaps="false"
        android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />
</LinearLayout>