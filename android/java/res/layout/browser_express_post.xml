<?xml version="1.0" encoding="utf-8"?>
<!-- A feed post card (Figma "Express/Post Card", light 1:188/1:209/1:231, dark 3:643/3:664/3:791):
     author and time, caption, then a photo/video or an audio player, and the reaction rail that
     opens the post's comments. On a photo or video the rail is laid over the media's bottom edge;
     otherwise it closes the card. Cards sit 12dp in from the screen edges, 4dp apart, on the feed
     background. A ⋯ menu over the header's end offers "Not interested", which swaps the card for
     the slim "Post hidden · Undo" row. PostListAdapter.PostHolder binds it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/post_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/browser_express_feed_background"
    android:paddingHorizontal="12dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/post_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/browser_express_post_card_bg"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Ends short of the ⋯ button laid over the card's top end. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="26dp"
            tools:ignore="RtlSymmetry">

            <ImageView
                android:id="@+id/post_author_avatar"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/browser_express_post_avatar_placeholder" />

            <TextView
                android:id="@+id/post_author_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/browser_express_post_author"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/post_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/browser_express_post_time"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/post_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="-0.01"
            android:textColor="@color/browser_express_post_caption"
            android:textSize="14sp" />

        <!-- "12 new takes" on a text post (design_handoff_new_takes §3): a dark panel under the
             caption. A photo or video post shows the same callout over its media instead. -->
        <org.chromium.chrome.browser.ntp.NewTakesCallout
            android:id="@+id/post_new_takes_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/browser_express_post_new_takes_panel_bg"
            android:paddingStart="12dp"
            android:paddingTop="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp"
            android:visibility="gone" />

        <!-- Photo or video, at the media's own aspect ratio (clamped in the adapter). -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/post_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/browser_express_post_media_bg"
            android:visibility="gone">

            <Space
                android:id="@+id/post_media_ratio"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="H,16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- The photo, or a video's poster frame until the video draws. -->
            <ImageView
                android:id="@+id/post_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/post_media_ratio"
                app:layout_constraintEnd_toEndOf="@id/post_media_ratio"
                app:layout_constraintStart_toStartOf="@id/post_media_ratio"
                app:layout_constraintTop_toTopOf="@id/post_media_ratio" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/post_video"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/post_media_ratio"
                app:layout_constraintEnd_toEndOf="@id/post_media_ratio"
                app:layout_constraintStart_toStartOf="@id/post_media_ratio"
                app:layout_constraintTop_toTopOf="@id/post_media_ratio"
                app:resize_mode="zoom"
                app:shutter_background_color="@android:color/transparent"
                app:surface_type="texture_view"
                app:use_controller="false" />

            <!-- Dims the media under the "new takes" callout (NewTakesCallout.DimDrawable); a
                 video keeps playing under it. -->
            <View
                android:id="@+id/post_new_takes_dim"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/post_media_ratio"
                app:layout_constraintEnd_toEndOf="@id/post_media_ratio"
                app:layout_constraintStart_toStartOf="@id/post_media_ratio"
                app:layout_constraintTop_toTopOf="@id/post_media_ratio" />

            <!-- Shown while the video isn't playing. -->
            <ImageView
                android:id="@+id/post_video_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_browser_express_post_video_play"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/post_media_ratio"
                app:layout_constraintEnd_toEndOf="@id/post_media_ratio"
                app:layout_constraintStart_toStartOf="@id/post_media_ratio"
                app:layout_constraintTop_toTopOf="@id/post_media_ratio" />

            <!-- Not in the design: the feed-wide sound switch videos already had. -->
            <ImageButton
                android:id="@+id/post_video_mute"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_margin="8dp"
                android:background="@drawable/circular_button_background"
                android:contentDescription="@string/browser_express_post_video_sound"
                android:padding="4dp"
                android:src="@drawable/volume_off"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/post_media_ratio"
                app:layout_constraintTop_toTopOf="@id/post_media_ratio"
                app:tint="@android:color/white" />

            <!-- While the "new takes" callout shows, this lighter fade stands in for the rail's
                 own tint (§2c). -->
            <View
                android:id="@+id/post_new_takes_fade"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:background="@drawable/browser_express_post_new_takes_fade"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/post_media_ratio"
                app:layout_constraintEnd_toEndOf="@id/post_media_ratio"
                app:layout_constraintStart_toStartOf="@id/post_media_ratio" />

            <!-- "12 new takes since you last looked", centred in the media above its bottom 30dp
                 (§2b). Taps go through to the card, which opens the stream at the first of them. -->
            <org.chromium.chrome.browser.ntp.NewTakesCallout
                android:id="@+id/post_new_takes_callout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:paddingHorizontal="12dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/post_media_ratio"
                app:layout_constraintEnd_toEndOf="@id/post_media_ratio"
                app:layout_constraintStart_toStartOf="@id/post_media_ratio"
                app:layout_constraintTop_toTopOf="@id/post_media_ratio" />

            <!-- The rail over the media's bottom edge: a 24dp row 3.8dp up from the bottom, over a
                 black tint (338:2254). The rail is taller than the tint so it is easy to tap. -->
            <LinearLayout
                android:id="@+id/post_media_rail"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:background="@drawable/browser_express_post_media_tint"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="16.2dp"
                android:paddingEnd="4dp"
                android:paddingBottom="3.8dp"
                app:layout_constraintBottom_toBottomOf="@id/post_media_ratio"
                app:layout_constraintEnd_toEndOf="@id/post_media_ratio"
                app:layout_constraintStart_toStartOf="@id/post_media_ratio">

                <TextView
                    android:id="@+id/post_media_rail_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/browser_express_post_media_rail_text"
                    android:textFontWeight="600"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/post_media_rail_mix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:alpha="0.86"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/post_media_rail_reaction_1"
                        style="@style/BrowserExpressCommentsBarReaction" />

                    <TextView
                        android:id="@+id/post_media_rail_reaction_2"
                        style="@style/BrowserExpressCommentsBarReaction" />

                    <TextView
                        android:id="@+id/post_media_rail_reaction_3"
                        style="@style/BrowserExpressCommentsBarReaction" />
                </LinearLayout>

                <!-- The post's XP: every emoji given to its comments ("1.2K XP", unit smaller). -->
                <TextView
                    android:id="@+id/post_media_rail_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/browser_express_post_media_rail_xp"
                    android:textFontWeight="500"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- The whole rail opens the comments; the ring is its marker. -->
                <FrameLayout
                    android:id="@+id/post_media_rail_open"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:alpha="0.7"
                    android:background="@drawable/browser_express_post_media_open_bg"
                    android:importantForAccessibility="no">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_browser_express_post_chevron"
                        app:tint="@color/browser_express_post_media_open_chevron" />
                </FrameLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Voice post (Figma "Express/Audio player"). -->
        <LinearLayout
            android:id="@+id/post_audio"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/browser_express_post_audio_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/post_audio_play"
                android:layout_width="43dp"
                android:layout_height="43dp"
                android:background="@null"
                android:contentDescription="@string/browser_express_post_audio_play"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_browser_express_post_audio_play" />

            <SeekBar
                android:id="@+id/post_audio_seek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:progressDrawable="@drawable/browser_express_post_audio_progress"
                android:splitTrack="false"
                android:thumb="@drawable/browser_express_post_audio_thumb" />

            <TextView
                android:id="@+id/post_audio_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:lineHeight="16sp"
                android:textColor="@color/browser_express_post_audio_time"
                android:textFontWeight="600"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Reaction rail for text and voice posts: "N reactions" (the comment count), the top
             emoji, the post's XP, and a chevron into the comments. -->
        <LinearLayout
            android:id="@+id/post_reaction_rail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/browser_express_post_rail_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="5dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/post_rail_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/browser_express_post_rail_text"
                android:textFontWeight="600"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/post_rail_mix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0.86"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/post_rail_reaction_1"
                    style="@style/BrowserExpressCommentsBarReaction" />

                <TextView
                    android:id="@+id/post_rail_reaction_2"
                    style="@style/BrowserExpressCommentsBarReaction" />

                <TextView
                    android:id="@+id/post_rail_reaction_3"
                    style="@style/BrowserExpressCommentsBarReaction" />
            </LinearLayout>

            <!-- The post's XP: every emoji given to its comments ("1.2K XP", unit smaller). -->
            <TextView
                android:id="@+id/post_rail_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:textColor="@color/browser_express_post_rail_xp"
                android:textFontWeight="500"
                android:textSize="11sp"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/post_rail_open"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:alpha="0.9">

                <ImageView
                    android:id="@+id/post_rail_chevron"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_browser_express_post_chevron"
                    app:tint="@color/browser_express_post_rail_chevron" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- The card's ⋯ menu, centred on the header row (2dp root padding + 10dp card padding + half
         the 16dp row = 20dp down). A sibling of the card so its tap never opens the post. -->
    <ImageView
        android:id="@+id/post_menu"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/browser_express_post_menu"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_browser_express_post_more" />

    <!-- In the card's place once the reader picks "Not interested". -->
    <LinearLayout
        android:id="@+id/post_hidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/browser_express_post_card_bg"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="2dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/browser_express_post_hidden"
            android:textColor="@color/browser_express_post_author"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/post_hidden_undo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/browser_express_post_hidden_undo"
            android:textColor="@color/browser_express_post_more"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
