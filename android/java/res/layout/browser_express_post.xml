<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/post_layout"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/twitter_post_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="15dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/twitter_profile_picture"
                android:src="@drawable/btn_toolbar_profile"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:scaleType="centerCrop"
                android:layout_gravity="center"
                android:layout_marginEnd="8sp"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"
                android:adjustViewBounds="true" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/twitter_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/username_color"
                    android:textSize="14sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton 
                android:id="@+id/post_menu_btn"
                style="@style/ToolbarButton"
                android:background="@drawable/ic_more_vert_24dp"
                android:layout_width="20sp"
                android:layout_height="20sp"
                android:layout_gravity="center"
                android:visibility="visible"
                android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />
        </LinearLayout>

        <TextView
            android:id="@+id/twitter_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/content_color"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_read_more_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/be_read_more"
            android:background="@android:color/transparent"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/set_default_text_color"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingVertical="2sp"
            android:paddingHorizontal="0dp"
            android:textAllCaps="false"
            android:visibility="gone"
            android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

        <androidx.cardview.widget.CardView
            android:id="@+id/twitter_media_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:cardCornerRadius="12dp"
            app:contentPadding="0sp"
            android:visibility="gone"
            android:layout_margin="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/twitter_media_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Space
                    android:id="@+id/media_aspect_ratio_spacer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="H,16:9" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/twitter_video"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintBottom_toBottomOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintStart_toStartOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintEnd_toEndOf="@id/media_aspect_ratio_spacer"
                    android:visibility="gone"
                    app:surface_type="texture_view"
                    app:use_controller="false"
                    app:resize_mode="fit"/>

                <ImageView
                    android:id="@+id/twitter_image"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintBottom_toBottomOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintStart_toStartOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintEnd_toEndOf="@id/media_aspect_ratio_spacer"
                    android:src="@drawable/loading_image"
                    android:visibility="gone"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>

                <ImageView
                    android:id="@+id/play_pause_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintBottom_toBottomOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintStart_toStartOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintEnd_toEndOf="@id/media_aspect_ratio_spacer"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>

                <ProgressBar
                    android:id="@+id/video_progress"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintEnd_toEndOf="@id/media_aspect_ratio_spacer"
                    app:layout_constraintBottom_toBottomOf="@id/media_aspect_ratio_spacer"
                    android:progressTint="@color/browser_express_orange_color"
                    android:background="@android:color/transparent"/>

                <ImageButton
                    android:id="@+id/video_mute_button"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="8dp"
                    android:padding="4dp"
                    android:background="@drawable/circular_button_background"
                    android:src="@drawable/volume_off"
                    app:tint="@android:color/white"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/news_settings_title_color"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="4sp"
        app:cardCornerRadius="12dp">
        <ImageView
            android:id="@+id/post_image"
            android:src="@drawable/loading_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"
            android:maxHeight="200sp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet"/>
    </androidx.cardview.widget.CardView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="2sp"
        android:layout_marginHorizontal="15dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/publisher_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/news_settings_title_color"
            android:textSize="11sp"/>
    </LinearLayout>
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/news_settings_title_color"
        android:layout_marginVertical="2sp"
        android:layout_marginHorizontal="15dp"
        android:textStyle="bold"
        android:textSize="14sp"/>
    <TextView
        android:id="@+id/post_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/news_settings_title_color"
        android:layout_marginTop="4sp"
        android:layout_marginHorizontal="15dp"
        android:visibility="gone"
        android:textSize="11sp"/>
    <Button
        android:id="@+id/btn_read_more_post2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/be_read_more"
        android:background="@android:color/transparent"
        style="?android:attr/borderlessButtonStyle"
        android:textColor="@color/set_default_text_color"
        android:textSize="11sp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingVertical="2sp"
        android:paddingHorizontal="0dp"
        android:layout_marginHorizontal="15dp"
        android:textAllCaps="false"
        android:visibility="gone"
        android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_top_comments"
        android:layout_width="match_parent"
        android:layout_marginHorizontal="15dp"
        android:layout_weight="1"
        android:layout_height="0dp"/>

    <Button
        android:id="@+id/btn_comment"
        android:layout_marginVertical="-10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        style="?android:attr/borderlessButtonStyle"
        android:textColor="@color/browser_express_blue_color"
        android:layout_marginHorizontal="15dp"
        android:includeFontPadding="false"
        android:textSize="16sp"
        android:fontWeight="600"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingVertical="-10sp"
        android:paddingHorizontal="4dp"
        android:textAllCaps="false"
        android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

    <LinearLayout
        android:id="@+id/edit_text_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="12dp"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/rounded_edittext">
        <ImageView
            android:background="@drawable/comments"
            android:layout_height="14sp"
            android:layout_width="14sp"
            android:layout_gravity="center"
            android:layout_marginEnd="10sp"
            android:contentDescription="@string/accessibility_toolbar_btn_brave_wallet" />

        <TextView
            android:text="@string/type_your_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/brave_theme_hint_text"
            android:textSize="13sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginVertical="16dp"
        android:background="@color/vote_border_color"/>

</LinearLayout>