<!-- The top of the reaction picker's list: the comment's reactions as chips (Figma 483:3263),
     then the line above the emoji sections. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <org.chromium.chrome.browser.browser_express_comments.ReactionChipFlowLayout
        android:id="@+id/reaction_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/browser_express_comment_picker_divider" />
</LinearLayout>
