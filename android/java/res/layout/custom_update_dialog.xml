<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="0dp"
    android:background="@drawable/update_dialog_background">

    <!-- Header with Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/update_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_update_available"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/update_dialog_title_available" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/update_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_dialog_title_available"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/update_dialog_title_color"/>

            <TextView
                android:id="@+id/update_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_dialog_subtitle"
                android:textSize="14sp"
                android:textColor="@color/update_dialog_subtitle_color"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/update_dialog_divider_color"
        android:layout_marginHorizontal="24dp" />

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/update_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/update_dialog_version_color"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/update_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/update_dialog_message_default"
                android:textSize="14sp"
                android:textColor="@color/update_dialog_message_color"
                android:lineSpacingExtra="4dp"/>

            <!-- Security Badge for Force Updates -->
            <LinearLayout
                android:id="@+id/security_badge_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/security_badge_background"
                android:padding="8dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_security_shield"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/update_dialog_security_badge" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/update_dialog_security_badge"
                    android:textSize="12sp"
                    android:textColor="@color/security_badge_text_color"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_later"
            style="@style/UpdateDialogButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_dialog_button_later"
            android:layout_marginEnd="8dp"
            android:minWidth="80dp" />

        <Button
            android:id="@+id/btn_update"
            style="@style/UpdateDialogButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_dialog_button_update"
            android:minWidth="100dp" />
    </LinearLayout>
</LinearLayout>