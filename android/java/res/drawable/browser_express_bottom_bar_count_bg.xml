<!-- The comment-count badge on the bar's reels icon. Rounded rather than oval so a longer
     count stretches it into a pill. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/browser_express_bottom_bar_count_background" />
    <stroke
        android:width="1dp"
        android:color="@color/browser_express_bottom_bar_count_stroke" />
    <corners android:radius="8dp" />
</shape>
