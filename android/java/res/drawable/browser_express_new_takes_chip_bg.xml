<!-- A "new takes" format chip: 28dp tall, white at 16% with a 0.5dp white ring at 30%. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="@color/browser_express_new_takes_chip" />
    <stroke
        android:width="0.5dp"
        android:color="@color/browser_express_new_takes_chip_ring" />
</shape>
