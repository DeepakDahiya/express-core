    android:shape="oval">
    <gradient
        android:centerColor="@color/browser_express_yt_premium_glow_center"
        android:endColor="@color/browser_express_yt_premium_glow_end"
        android:gradientRadius="50%p"
        android:startColor="@color/browser_express_yt_premium_glow_start"
        android:type="radial" />
</shape>
