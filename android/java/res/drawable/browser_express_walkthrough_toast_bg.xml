<!-- The "All set" toast: a 36dp pill, Ink Black at 94%, inside a 1dp wasabi edge at 28%. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/browser_express_walkthrough_toast_edge" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="@color/browser_express_walkthrough_toast_bg" />
        </shape>
    </item>
</layer-list>
