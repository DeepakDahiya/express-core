<!-- One box of the code: a 1.5dp line, accent on the box taking the next digit (and on every
     digit while the code verifies; activated), lighter once it holds a digit (selected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/browser_express_ugc_signup_field" />
            <stroke android:width="1.5dp" android:color="@color/browser_express_ugc_signup_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/browser_express_ugc_signup_field" />
            <stroke
                android:width="1.5dp"
                android:color="@color/browser_express_ugc_signup_line_filled" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/browser_express_ugc_signup_field" />
            <stroke android:width="1.5dp" android:color="@color/browser_express_ugc_signup_line" />
        </shape>
    </item>
</selector>
