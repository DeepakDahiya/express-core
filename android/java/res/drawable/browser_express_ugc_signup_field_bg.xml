<!-- A sign-up field: 14dp corners, a 1dp line that turns accent while its input has focus (the
     field passes its child's focus up with addStatesFromChildren). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/browser_express_ugc_signup_field" />
            <stroke android:width="1dp" android:color="@color/browser_express_ugc_signup_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/browser_express_ugc_signup_field" />
            <stroke android:width="1dp" android:color="@color/browser_express_ugc_signup_line" />
        </shape>
    </item>
</selector>
