<!-- Hairline along the curved top edge of the reel sneak-peek strip, so the page below
     reads as a separate surface sliding up.

     The negative insets push the stroke's left, right and bottom runs outside the view, where
     they are clipped away — what is left is the top edge alone, following the same radius
     CommentSlideAdapter rounds the strip with. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="-2dp"
        android:left="-2dp"
        android:right="-2dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="@dimen/be_reel_peek_corner_radius"
                android:topRightRadius="@dimen/be_reel_peek_corner_radius" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
