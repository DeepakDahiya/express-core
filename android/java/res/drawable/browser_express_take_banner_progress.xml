<!-- The 3dp upload line along the banner's bottom. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/browser_express_take_progress_track" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/browser_express_take_progress" />
            </shape>
        </clip>
    </item>
</layer-list>
