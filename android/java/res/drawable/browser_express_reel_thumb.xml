<!-- The reel timeline's thumb: shown only while the reader drags it. Both states keep the same
     size so the line doesn't shift when it appears. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/browser_express_reel_progress" />
            <size android:width="12dp" android:height="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <size android:width="12dp" android:height="12dp" />
        </shape>
    </item>
</selector>
