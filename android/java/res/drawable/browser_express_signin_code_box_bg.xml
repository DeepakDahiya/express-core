<!-- The box the next digit goes into is marked selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/browser_express_signin_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/browser_express_signin_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/browser_express_signin_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/browser_express_signin_field_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
