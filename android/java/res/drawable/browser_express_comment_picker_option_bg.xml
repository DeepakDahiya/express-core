<!-- A reaction in the picker; selected is the reader's current reaction. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/browser_express_comment_picker_selected" />
            <stroke
                android:width="1dp"
                android:color="@color/browser_express_comment_picker_selected_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/browser_express_comment_picker_option" />
            <stroke
                android:width="1dp"
                android:color="@color/browser_express_comment_picker_option_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
