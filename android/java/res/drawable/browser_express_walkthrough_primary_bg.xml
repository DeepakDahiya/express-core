<!-- The primary button: a 32dp wasabi pill, drawn 6dp in from the top and bottom of its 44dp
     touch target (README §8). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="6dp"
    android:insetTop="6dp">
    <shape android:shape="rectangle">
        <corners android:radius="16dp" />
        <solid android:color="@color/browser_express_walkthrough_wasabi" />
    </shape>
</inset>
