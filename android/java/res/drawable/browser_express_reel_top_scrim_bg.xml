<!-- Darkens the top of a reel page under its header (Figma "Rectangle" over the reel, at most
     32%). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:centerColor="@color/browser_express_reel_top_scrim_center"
        android:centerY="0.614"
        android:endColor="@color/browser_express_reel_top_scrim_end"
        android:startColor="@color/browser_express_reel_top_scrim_start" />
</shape>
