<!-- The avatar placeholder: black in light mode, white in dark. Tinting the drawable itself
     (not the ImageView) leaves a loaded photo untouched. Media screens, dark in both themes,
     use btn_toolbar_profile_white directly. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/btn_toolbar_profile_white"
    android:tint="@color/browser_express_avatar_placeholder" />
