import("//build/config/android/rules.gni")

# This is the dedicated target for your Mini Player UI.
android_library("java") {
  sources = [ "BraveMiniPlayerManager.java" ]

  deps = [
    # Provides the R class, BraveActivity, and many other core app classes.
    "//chrome/android:chrome_java",
    
    # Provides the Tab class.
    "//chrome/browser/tab:java",
    
    # Provides WebContents and LoadUrlParams.
    "//content/public/android:content_full_java",
    
    # Provides base classes like Log.
    "//base:base_java",

    # Provides the native helper for JNI calls.
    "//brave/browser/android/youtube_script_injector:java",
  ]
  
  # This tells the build system where to find your mini_player_layout.xml
  # And where to generate the R class resources.
  resources_package = "org.chromium.chrome.browser"
}