<!-- Replaces Chromium's transparent placeholder (copied over
     chrome/android/java/res_chromium_base by branding.js). ic_launcher_round.xml draws this over
     @mipmap/layered_app_icon_background, which is the plain wasabi layer, so the round icon
     needs the whole UGC art here. That art is @mipmap/layered_app_icon, the same bitmap
     ic_launcher.xml uses. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/layered_app_icon" />
